{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vendly",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vendly-db",
      "database_id": "TU_DATABASE_ID_AQUI"
    }
  ]
}

