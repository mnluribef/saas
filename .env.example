# ============================================================
# Vendly SaaS — Variables de Entorno y Bindings de Cloudflare
# ============================================================
# Copia este archivo a .dev.vars para desarrollo local con Wrangler
# NUNCA incluyas valores reales en este archivo

# ----------------------------------------------------------
# OBLIGATORIAS
# ----------------------------------------------------------

# Clave secreta para endpoints de Super-Admin (/api/tenants, /api/superadmin/*)
# Genera con: openssl rand -hex 32
SUPERADMIN_KEY=cambia_esto_por_una_clave_segura_de_64_chars

# ----------------------------------------------------------
# CLOUDFLARE BINDINGS (wrangler.jsonc)
# ----------------------------------------------------------
# Estos NO son variables de entorno; se configuran en wrangler.jsonc:
#
# DB     → Cloudflare D1 (base de datos principal)
# BUCKET → Cloudflare R2 (imágenes de productos y comprobantes)
#
# Ejemplo en wrangler.jsonc:
# {
#   "d1_databases": [{ "binding": "DB", "database_name": "vendly-db", "database_id": "..." }],
#   "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vendly-assets" }]
# }

# ----------------------------------------------------------
# OPCIONALES — Seguridad
# ----------------------------------------------------------

# Secret de Cloudflare Turnstile para validación de bots en el checkout público
# Obtén en: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------
# OPCIONALES — Notificaciones
# ----------------------------------------------------------

# URL del Webhook para notificaciones de nuevos pedidos y cambios de estado
# Compatible con Make.com, n8n, Zapier, o cualquier endpoint HTTP
WEBHOOK_URL=

# ----------------------------------------------------------
# OPCIONALES — Facturación Manual (mostrado en /api/billing)
# ----------------------------------------------------------

PAYMENT_METHOD=Transferencia Bancaria / Pago Móvil
PAYMENT_BANK=Banesco
PAYMENT_PHONE=0412-0000000
PAYMENT_ID=V-00000000
PAYMENT_BINANCE=pagos@vendly.app
PAYMENT_ZELLE=pagos@vendly.app
