{
  "name": "vendly",
  "version": "1.0.0",
  "description": "Vendly — Plataforma SaaS multi-plantilla para catálogos y comercio digital ágil",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:pages": "concurrently \"pnpm run dev\" \"wrangler pages dev --proxy 4321\"",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "pnpm run build && wrangler pages deploy dist",
    "db:init:local": "wrangler d1 execute vendly-db --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute vendly-db --local --file=seed_templates.sql",
    "db:migrate:local": "wrangler d1 migrations apply vendly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vendly-db --remote",
    "create-admin": "node scripts/generate-admin.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "astro": "^7.2.4",
    "lucide-astro": "^0.556.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20250620.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.1"
  }
}
