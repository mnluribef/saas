---
import Layout from '../../layouts/BaseLayout.astro';
import defaultStoreConfig from '../../config/store.config';
import '../../styles/superadmin.css';
---
<Layout config={{...defaultStoreConfig, template: "restaurant"}} title="Super Admin | Vendly">
    <div class="superadmin-container">
        <!-- Login Step -->
        <div id="sa-login-step" class="sa-card">
            <h2 class="sa-title">Acceso Restringido</h2>
            <p class="sa-subtitle">Solo para fundadores y administradores maestros de Vendly.</p>
            <div class="sa-form">
                <input type="password" id="sa-password" placeholder="Contraseña Maestra..." class="sa-input">
                <button id="sa-login-btn" class="sa-btn-primary">Ingresar al Backoffice</button>
            </div>
            <p id="sa-error" class="sa-error hidden"></p>
        </div>

        <!-- Dashboard Step -->
        <div id="sa-dashboard-step" class="hidden">
            <div class="sa-header">
                <div>
                    <h2 class="sa-title">Backoffice de Operaciones</h2>
                    <p class="sa-subtitle">Gestiona clientes, pagos y suspensiones.</p>
                </div>
                <button id="sa-logout-btn" class="sa-btn-outline">Cerrar Sesión</button>
            </div>

            <div class="sa-stats-row">
                <div class="sa-stat-card">
                    <h3>Total Tiendas</h3>
                    <p id="stat-total" class="stat-number">0</p>
                </div>
                <div class="sa-stat-card">
                    <h3>Activas</h3>
                    <p id="stat-active" class="stat-number stat-green">0</p>
                </div>
                <div class="sa-stat-card">
                    <h3>Suspendidas</h3>
                    <p id="stat-suspended" class="stat-number stat-red">0</p>
                </div>
            </div>

            <div class="sa-table-container">
                <table class="sa-table">
                    <thead>
                        <tr>
                            <th>Subdominio</th>
                            <th>Negocio</th>
                            <th>Plan</th>
                            <th>Estado</th>
                            <th>Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="sa-tenants-list">
                        <tr><td colspan="6" style="text-align:center;">Cargando clientes...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</Layout>



<script src="../../scripts/superadmin.ts"></script>
