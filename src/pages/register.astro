---
// src/pages/register.astro
import Layout from '../layouts/BaseLayout.astro';
import { createStoreConfig } from '../config/store.config';
import { techTemplate } from '../config/templates/tech';

// Tema premium claro para el onboarding SaaS
const config = createStoreConfig('tech', {
    business: {
        ...techTemplate.business,
        name: 'Vendly SaaS',
        description: 'Crea tu tienda online en minutos.'
    },
    theme: {
        ...techTemplate.theme,
        primaryColor: '#6366f1',
        accentColor: '#10b981',
        bgPage: '#f8fafc',
    }
});
import '../styles/register.css';
---

<Layout config={config} title="Registrar Negocio | Vendly SaaS">
    <div class="register-container">
        <!-- Dynamic Background -->
        <div class="dynamic-bg" id="dynamic-bg"></div>
        <div class="dynamic-overlay"></div>
        
        <!-- Elementos decorativos de fondo -->
        <div class="blob-1"></div>
        <div class="blob-2"></div>
        
        <div class="register-card">
            <div class="header">
                <a href="/" class="back-link">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Volver
                </a>
                <div class="brand-logo">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.9 9.3l-2-6A2 2 0 0 0 17 2H7a2 2 0 0 0-1.9 1.3l-2 6a2 2 0 0 0 .1 1.7L4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7l.8-1a2 2 0 0 0 .1-1.7z"></path>
                        <line x1="12" y1="12" x2="12" y2="21"></line>
                        <path d="M4 12h16"></path>
                    </svg>
                    <h1>Vendly</h1>
                </div>
                <h2>Crea tu Tienda Online</h2>
                <p>Comienza a vender en minutos y lleva tu negocio al siguiente nivel.</p>
            </div>

            <form id="onboarding-form" class="onboarding-form">
                <div class="form-step active" id="step-1">
                    <div class="step-indicator">
                        <span class="step-badge">Paso 1 de 2</span>
                    </div>
                    <h3>Datos de tu Negocio</h3>
                    
                    <div class="form-group">
                        <label for="tenantName">Nombre de tu Negocio</label>
                        <input type="text" id="tenantName" name="tenantName" required placeholder="Ej: Fogón La Victoria" autocomplete="organization">
                    </div>

                    <div class="form-group">
                        <label for="tenantSlug">Dirección Web (Subdominio)</label>
                        <div class="input-group">
                            <input type="text" id="tenantSlug" name="tenantSlug" required placeholder="fogon-la-victoria" pattern="^[a-z0-9\-]+$" title="Solo minúsculas, números y guiones">
                            <span class="addon">.vendly.app</span>
                        </div>
                        <small>Esta será la URL de tu tienda. No podrás cambiarla luego.</small>
                    </div>

                    <div class="form-group">
                        <label>Tipo de Negocio (Plantilla)</label>
                        <div class="template-selector">
                            <label class="template-card">
                                <input type="radio" name="template" value="restaurant" checked>
                                <div class="card-content">
                                    <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path><path d="M7 2v20"></path><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path></svg>
                                    <span class="name">Restaurante / Comida</span>
                                </div>
                            </label>
                            <label class="template-card">
                                <input type="radio" name="template" value="hardware">
                                <div class="card-content">
                                    <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                                    <span class="name">Ferretería / Herramientas</span>
                                </div>
                            </label>
                            <label class="template-card">
                                <input type="radio" name="template" value="autoparts">
                                <div class="card-content">
                                    <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon"><circle cx="12" cy="12" r="8"></circle><path d="m21.17 6.83-2.83 2.83"></path><path d="m17.17 14.17-2.83-2.83"></path><path d="m9.83 9.83-2.83-2.83"></path><path d="m2.83 17.17 2.83-2.83"></path><path d="m17.17 9.83-2.83 2.83"></path><path d="m9.83 14.17-2.83 2.83"></path></svg>
                                    <span class="name">Repuestos Automotrices</span>
                                </div>
                            </label>
                            <label class="template-card">
                                <input type="radio" name="template" value="fashion">
                                <div class="card-content">
                                    <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M20.38 3.46 16 2a8 8 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path></svg>
                                    <span class="name">Ropa / Moda</span>
                                </div>
                            </label>
                            <label class="template-card">
                                <input type="radio" name="template" value="tech">
                                <div class="card-content">
                                    <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon"><rect width="14" height="8" x="5" y="2" rx="2"></rect><rect width="20" height="8" x="2" y="14" rx="2"></rect><path d="M6 18h2"></path><path d="M12 18h6"></path></svg>
                                    <span class="name">Tecnología / Gadgets</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <button type="button" class="btn-primary next-step" data-target="step-2">
                        Continuar
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>

                <div class="form-step" id="step-2">
                    <div class="step-indicator">
                        <span class="step-badge">Paso 2 de 2</span>
                    </div>
                    <h3>Cuenta de Administrador</h3>
                    
                    <div class="form-group">
                        <label for="username">Usuario Admin</label>
                        <input type="text" id="username" name="username" required placeholder="Ej: admin" autocomplete="username">
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" required placeholder="Mínimo 8 caracteres" minlength="8" autocomplete="new-password">
                    </div>

                    <div class="form-group">
                        <label for="whatsapp">WhatsApp (Para recibir pedidos)</label>
                        <input type="tel" id="whatsapp" name="whatsapp" placeholder="Ej: +584141234567">
                        <small>Los pedidos de tus clientes llegarán a este número.</small>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary prev-step" data-target="step-1">
                            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            Atrás
                        </button>
                        <button type="submit" class="btn-primary" id="submit-btn">
                            <span class="btn-text">Crear mi Tienda</span>
                            <div class="spinner hidden"></div>
                        </button>
                    </div>
                    
                    <div id="error-message" class="error-msg hidden"></div>
                </div>
            </form>
            
            <div id="success-state" class="success-state hidden">
                <div class="success-icon">
                    <div class="glow-circle">
                        <svg viewBox="0 0 24 24" width="48" height="48" stroke="var(--primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                </div>
                <h2>¡Tienda Creada Exitosamente!</h2>
                <p>Tu negocio ya está configurado y listo para recibir clientes.</p>
                <div class="store-links">
                    <a href="#" id="store-url" class="btn-primary" target="_blank">
                        Visitar mi Tienda
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                    <a href="#" id="admin-url" class="btn-secondary">Ir al Panel de Control</a>
                </div>
            </div>
        </div>
    </div>
</Layout>



<script src="../scripts/register.ts"></script>
