---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { techTemplate } from '../config/templates/tech';
import '../styles/precios.css';

const saasConfig = {
    ...techTemplate,
    template: 'tech' as const,
    business: { 
        ...techTemplate.business, 
        name: "Vendly", 
        shortName: "Vendly",
        tagline: "Plataforma de E-commerce y Pedidos por WhatsApp",
        logoTextPrimary: "VENDLY", 
        logoTextSecondary: "SAAS",
        description: "La solución líder para crear tu tienda virtual en minutos y recibir pedidos directamente en tu WhatsApp.",
        siteUrl: "https://vendly-20w.pages.dev"
    },
    seo: {
        title: "Planes y Precios | Vendly SaaS",
        description: "Escala tu negocio con nuestros planes. Sin comisiones por venta.",
        keywords: "tienda online venezuela, catalogo whatsapp, pedidos whatsapp, ecommerce venezuela, vendly, tasa bcv",
        schemaType: "SoftwareApplication" as const,
        priceRange: "$$"
    },
    nav: {
        links: [
            { label: "Inicio", href: "/" },
            { label: "Características", href: "/#features" },
            { label: "Planes", href: "/precios" },
            { label: "Acceder", href: "/login" },
            { label: "Crear Tienda", href: "/register" }
        ]
    }
};
---

<BaseLayout config={saasConfig} title="Planes y Precios | Vendly SaaS">
    <Header config={saasConfig} />
    
    <main class="pricing-page">
        <section class="pricing-hero">
            <div class="pricing-hero-content reveal">
                <h1>El poder de escalar, <br/><span class="highlight">sin comisiones ocultas</span></h1>
                <p>Comienza completamente gratis y escala a medida que tu negocio crece. Nuestro modelo es transparente: el 100% de tus ventas es tuyo.</p>
            </div>
        </section>

        <section class="pricing-cards-section">
            <div class="pricing-grid">
                
                <!-- Plan Básico -->
                <div class="pricing-card reveal">
                    <div class="card-header">
                        <h3>Básico</h3>
                        <p class="price">Gratis</p>
                        <p class="billing">Para siempre. Cero riesgo.</p>
                    </div>
                    <div class="card-body">
                        <p class="plan-desc">Ideal para emprendedores probando su catálogo y recibiendo sus primeros pedidos en WhatsApp.</p>
                        <ul class="features-list">
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Catálogo digital responsivo</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Pedidos detallados a WhatsApp</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Límite de <strong>30 productos</strong></li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Hasta <strong>100 pedidos</strong> al mes</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Sincronización básica tasa BCV</li>
                        </ul>
                        <a href="/register" class="btn-outline">Comenzar gratis</a>
                    </div>
                </div>

                <!-- Plan PRO -->
                <div class="pricing-card popular reveal" style="animation-delay: 0.1s;">
                    <div class="popular-badge">SaaS Recomendado</div>
                    <div class="card-header">
                        <h3>Profesional</h3>
                        <p class="price">$15<span class="period">/mes</span></p>
                        <p class="billing">Facturado anualmente o $19 mes a mes</p>
                    </div>
                    <div class="card-body">
                        <p class="plan-desc">El motor definitivo para comercios establecidos que buscan automatizar procesos y manejar volumen.</p>
                        <ul class="features-list">
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Todo el poder del plan Básico</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Límite de <strong>500 productos</strong></li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Pedidos ilimitados</strong> mensuales</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Gestión avanzada de Inventario</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Analíticas de Conversión</li>
                        </ul>
                        <a href="/register" class="btn-primary">Escalar ahora</a>
                    </div>
                </div>

                <!-- Plan Enterprise -->
                <div class="pricing-card reveal" style="animation-delay: 0.2s;">
                    <div class="card-header">
                        <h3>Empresarial</h3>
                        <p class="price">$45<span class="period">/mes</span></p>
                        <p class="billing">Solución B2B y franquicias</p>
                    </div>
                    <div class="card-body">
                        <p class="plan-desc">Infraestructura dedicada, marca blanca y soporte prioritario para operaciones a gran escala.</p>
                        <ul class="features-list">
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Inventario y Pedidos ilimitados</strong></li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Dominio Personalizado (.com/.ve)</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Remoción de logo "Vendly"</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Acceso a API Privada</li>
                            <li><svg viewBox="0 0 24 24" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte Técnico Dedicado 24/7</li>
                        </ul>
                        <a href="/register" class="btn-outline">Contactar Ventas</a>
                    </div>
                </div>

            </div>
        </section>
        
        <section class="faq-minimal reveal">
            <h2>Preguntas Frecuentes</h2>
            <div class="faq-grid">
                <div class="faq-item">
                    <h4>¿Existe alguna comisión oculta por mis ventas?</h4>
                    <p>Absolutamente no. A diferencia de otras plataformas o marketplaces, en Vendly el 100% del dinero de tus ventas va directamente a ti, a través de los métodos que tú configures (Pago Móvil, Zelle, Efectivo).</p>
                </div>
                <div class="faq-item">
                    <h4>¿Me exigen tarjeta de crédito para la versión gratuita?</h4>
                    <p>No. Puedes abrir tu tienda hoy mismo y mantenerla en el plan Básico para siempre sin introducir ningún dato bancario o de tarjeta de crédito.</p>
                </div>
                <div class="faq-item">
                    <h4>¿La tasa BCV se actualiza sola?</h4>
                    <p>Sí. Nuestro sistema obtiene diariamente la tasa oficial del Banco Central de Venezuela. Tus clientes verán los precios precisos en Bolívares y Dólares sin que tengas que usar la calculadora.</p>
                </div>
                <div class="faq-item">
                    <h4>¿Puedo cambiar o cancelar mi plan?</h4>
                    <p>Por supuesto. Desde tu panel administrativo podrás subir o bajar de plan en un clic, o cancelar tu suscripción sin ataduras ni contratos forzosos.</p>
                </div>
            </div>
        </section>
    </main>

    <Footer config={saasConfig} />
</BaseLayout>

<script src="../scripts/precios.js"></script>
