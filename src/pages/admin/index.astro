---
// src/pages/admin/index.astro
// Panel Administrativo - Vendly SaaS
import AdminLayout from '../../layouts/AdminLayout.astro';
import Metrics from '../../components/admin/Metrics.astro';
import Orders from '../../components/admin/Orders.astro';
import Sales from '../../components/admin/Sales.astro';
import Inventory from '../../components/admin/Inventory.astro';
import Billing from '../../components/admin/Billing.astro';
import Modals from '../../components/admin/Modals.astro';
---

<AdminLayout>
    <Metrics />
    <Orders />
    <Sales />
    <Inventory />
    <Billing />

    <Modals />
    
    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <script src="/admin.js" is:inline></script>
    <script is:inline>
        lucide.createIcons();

        const style = document.createElement("style");
        style.innerHTML = `
      @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      .spin { display: inline-block; animation: spin 1s linear infinite; }
    `;
        document.head.appendChild(style);

        window.addEventListener("DOMContentLoaded", () => {
            if (typeof checkSession === "function") {
                checkSession();
            }
        });
    </script>
</AdminLayout>
