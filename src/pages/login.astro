---
// src/pages/login.astro - Página de inicio de sesión del panel admin Vendly
import storeConfig from '../config/store.config';

const error = Astro.url.searchParams.get('error');
const errorMsg: Record<string, string> = {
  expired: 'Tu sesión ha expirado. Inicia sesión de nuevo.',
  server: 'Error interno. Intenta de nuevo.',
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vendly | Acceso Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/login.css" />

</head>
<body>
  <div class="login-card">
    <div class="logo">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
      <span>Vend<span>ly</span></span>
    </div>
    <p class="subtitle">Panel de Control &middot; Acceso Restringido</p>
    <div class="store-badge">
      <span>Entorno activo: <strong>{storeConfig.business.name}</strong></span>
    </div>

    {error && <div class="error-msg">{errorMsg[error] || 'Credenciales incorrectas. Intenta de nuevo.'}</div>}
    <div id="login-error" class="error-msg" style="display:none;"></div>

    <form id="login-form">
      <div class="field">
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" autocomplete="username" required placeholder="admin">
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required placeholder="••••••••">
      </div>
      <button type="submit" class="login-btn" id="login-btn">Iniciar Sesión</button>
    </form>
  </div>

  <script src="../scripts/login.ts"></script>
</body>
</html>
