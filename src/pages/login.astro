---
// src/pages/login.astro - Página de inicio de sesión del panel admin Ventrina
import storeConfig from '../config/store.config';
import '../styles/login.css';

const error = Astro.url.searchParams.get('error');
const tenantParam = Astro.url.searchParams.get('tenant') || '';
const errorMsg: Record<string, string> = {
  expired: 'Tu sesión ha expirado. Inicia sesión de nuevo.',
  server: 'Error interno. Intenta de nuevo.',
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ventrina | Acceso Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <div class="login-card">
    <div class="logo">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
      <span>Vent<span>rina</span></span>
    </div>
    <p class="subtitle">Panel de Control &middot; Acceso Restringido</p>
    <div class="store-badge">
      <span>{tenantParam ? `Tienda: ` : `Entorno activo: `}<strong>{tenantParam || storeConfig.business.name}</strong></span>
    </div>

    {error && <div class="error-msg">{errorMsg[error] || 'Credenciales incorrectas. Intenta de nuevo.'}</div>}
    <div id="login-error" class="error-msg hidden"></div>

    <form id="login-form">
      <div class="field">
        <label for="email">Correo Electrónico</label>
        <input type="email" id="email" name="email" autocomplete="email" required placeholder="tu@correo.com">
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required placeholder="••••••••">
      </div>
      <div class="field">
        <label for="tenant">Tienda o Slug (Opcional si tu correo es único)</label>
        <input type="text" id="tenant" name="tenant" placeholder="ej: mi-tienda" value={tenantParam}>
      </div>
      <button type="submit" class="login-btn" id="login-btn">Iniciar Sesión</button>
    </form>

    <div class="login-footer-links">
      <a href="/">← Volver al inicio</a>
      <a href="/register">Crear tienda nueva</a>
    </div>
  </div>

  <script src="../scripts/login.ts"></script>
</body>
</html>
