---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { techTemplate } from '../config/templates/tech';

// Configuración de alto contraste y profesional para el SaaS Vendly
const saasConfig = {
    ...techTemplate,
    template: 'tech' as const,
    business: { 
        ...techTemplate.business, 
        name: "Vendly", 
        shortName: "Vendly",
        tagline: "Plataforma de E-commerce y Pedidos por WhatsApp",
        logoTextPrimary: "VENDLY", 
        logoTextSecondary: "SAAS",
        description: "La solución líder para crear tu tienda virtual en minutos y recibir pedidos directamente en tu WhatsApp.",
        siteUrl: "https://vendly-20w.pages.dev"
    },
    seo: {
        title: "Vendly | Crea tu Tienda Online y Vende por WhatsApp en Minutos",
        description: "Vendly te permite crear tu catálogo virtual interactivo, sincronizar tasa BCV en tiempo real y recibir pedidos directamente a WhatsApp sin comisiones.",
        keywords: "tienda online venezuela, catalogo whatsapp, pedidos whatsapp, ecommerce venezuela, vendly, tasa bcv",
        schemaType: "SoftwareApplication",
        priceRange: "$"
    },
    nav: {
        links: [
            { label: "Características", href: "#features" },
            { label: "Planes", href: "/precios" },
            { label: "Demos", href: "#demos" },
            { label: "Acceder", href: "/login" },
            { label: "Crear Tienda", href: "/register" }
        ]
    }
};
import '../styles/landing.css';
---

<BaseLayout 
  config={saasConfig} 
  title="Vendly | Crea tu Tienda Online y Vende por WhatsApp en Minutos"
  description="Vendly te permite crear tu catálogo virtual interactivo, sincronizar tasa BCV en tiempo real y recibir pedidos directamente a WhatsApp sin comisiones."
>
  <Header config={saasConfig} />
  <main>
    <!-- Hero Section -->
    <section class="hero-premium">
      <div class="hero-premium-content">
        <div class="pill-badge">
          <span>🚀 Plataforma SaaS 2026 · <span class="highlight">0% Comisiones</span></span>
        </div>
        <h1>
          Escala tus ventas con <br/>
          <span class="text-gradient">tu tienda </span> <span class="text-accent">WhatsApp</span>
        </h1>
        <p>
          Crea tu catálogo interactivo en minutos, sincroniza inventario y recibe pedidos completos directamente en tu WhatsApp. Diseñado para emprendedores que buscan conversión rápida y sin fricción.
        </p>
        <div class="hero-actions">
          <a href="/register" class="btn-primary-glow">
            <span>Crear Tienda Gratis</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#demos" class="btn-secondary-glass">Ver Tiendas Demo</a>
        </div>

        <div class="dashboard-preview">
          <div class="mockup-window">
            <div class="mockup-header">
              <div class="dots-group">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <div class="mockup-address-bar">https://admin.vendly.app</div>
            </div>
            <div class="mockup-body">
              <div class="mockup-sidebar">
                <div class="sidebar-item active">📊 Métricas</div>
                <div class="sidebar-item">📦 Productos</div>
                <div class="sidebar-item">💬 Pedidos</div>
                <div class="sidebar-item">⚙️ Configuración</div>
              </div>
              <div class="mockup-content">
                <div class="mockup-top-metrics">
                  <div class="metric-card">
                    <span class="metric-title">Ingresos Mensuales</span>
                    <strong class="metric-value">$8,450.00</strong>
                    <span class="metric-change">↑ +24% vs mes anterior</span>
                  </div>
                  <div class="metric-card">
                    <span class="metric-title">Conversión WhatsApp</span>
                    <strong class="metric-value">68%</strong>
                    <span class="metric-change">↑ +5% automatizado</span>
                  </div>
                </div>
                <div class="mockup-order-preview">
                  <div class="order-preview-header">
                    <span class="order-tag">Última Venta #1049</span>
                    <span>Hace 2 min</span>
                  </div>
                  <div class="order-preview-item">
                    <div class="order-item-details">
                      <strong>Zapatos Nike Air Max (x1)</strong>
                      <span>Cliente: María Pérez · Pago Zelle</span>
                    </div>
                    <span class="order-price">$120.00</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Value Props / Features -->
    <section id="features" class="features-premium">
      <div class="container">
        <div class="section-header">
          <span class="badge">El Motor de tu Negocio</span>
          <h2>Todo para vender más en piloto automático</h2>
          <p>Vendly elimina el trabajo manual de vender por redes sociales. Tus clientes compran más rápido, tú gestionas sin estrés.</p>
        </div>
        
        <div class="features-grid">
          <div class="feature-card-premium">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-2 2.5h3L11 9h3l-5 13 3-9H9l2-4.5H8L13 2z"/></svg>
            </div>
            <h3>Lanzamiento en Minutos</h3>
            <p>Configura tu inventario usando nuestras plantillas listas para vender. No necesitas conocimientos de código ni semanas de desarrollo.</p>
          </div>
          
          <div class="feature-card-premium">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            </div>
            <h3>Pedidos Consolidados</h3>
            <p>Recibe los pedidos en tu WhatsApp con todos los datos: artículos, total, tasa de cambio y dirección de entrega de forma estructurada.</p>
          </div>
          
          <div class="feature-card-premium">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
            </div>
            <h3>Tasa Oficial Automatizada</h3>
            <p>Muestra tus precios en dólares y cobra en moneda local calculando automáticamente según la tasa BCV oficial del día. Cero errores.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Demos Grid -->
    <section id="demos" class="demos-premium">
      <div class="container">
        <div class="section-header">
          <span class="badge">Plantillas Optimizadas</span>
          <h2>Catálogos que convierten visitas en clientes</h2>
          <p>Explora cómo se vería tu negocio hoy mismo. Cada plantilla fue diseñada pensando en la mejor experiencia móvil.</p>
        </div>
        
        <div class="demos-grid">
          <a href="/demo/restaurant" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-img-wrapper">
              <img src="/assets/hero_grill.webp" alt="Restaurante" loading="lazy" />
            </div>
            <div class="demo-content">
              <h3>Gastronomía <span class="demo-arrow">→</span></h3>
              <p>Optimizada para menús con extras y opciones de delivery.</p>
            </div>
          </a>
          
          <a href="/demo/tech" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-img-wrapper">
              <img src="/assets/product_laptop.webp" alt="Tecnología" loading="lazy" />
            </div>
            <div class="demo-content">
              <h3>Tecnología y Electrónica <span class="demo-arrow">→</span></h3>
              <p>Ideal para specs técnicas y galerías de gadgets.</p>
            </div>
          </a>
          
          <a href="/demo/fashion" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-img-wrapper">
              <img src="/assets/hero_fashion.webp" alt="Moda" loading="lazy" />
            </div>
            <div class="demo-content">
              <h3>Moda y Boutiques <span class="demo-arrow">→</span></h3>
              <p>Foco visual en prendas, tallas y variaciones de color.</p>
            </div>
          </a>

          <a href="/demo/hardware" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-img-wrapper">
              <img src="/assets/product_taladro.webp" alt="Ferretería" loading="lazy" />
            </div>
            <div class="demo-content">
              <h3>Ferretería y Taller <span class="demo-arrow">→</span></h3>
              <p>Catálogo masivo para herramientas y repuestos técnicos.</p>
            </div>
          </a>

          <a href="/demo/autoparts" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-img-wrapper">
              <img src="/assets/product_frenos.webp" alt="Autopartes" loading="lazy" />
            </div>
            <div class="demo-content">
              <h3>Auto Periquitos <span class="demo-arrow">→</span></h3>
              <p>Estructura industrial para accesorios y recambios automotrices.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="cta-premium">
      <div class="cta-box">
        <h2>¿Listo para digitalizar tus ventas?</h2>
        <p>No dejes que los clientes se escapen por fricción al comprar. Crea tu enlace, ponlo en tu Instagram y mira cómo crecen tus pedidos diarios.</p>
        <div class="cta-actions">
          <a href="/register" class="btn-primary-glow">Empezar a Vender</a>
        </div>
      </div>
    </section>
  </main>
  <Footer config={saasConfig} />
</BaseLayout>


