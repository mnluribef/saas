---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { techTemplate } from '../config/templates/tech';

// Configuración de alto contraste y profesional para el SaaS Vendly
const saasConfig = {
    ...techTemplate,
    template: 'tech' as const,
    business: { 
        ...techTemplate.business, 
        name: "Vendly", 
        shortName: "Vendly",
        tagline: "Plataforma de E-commerce y Pedidos por WhatsApp",
        logoTextPrimary: "VENDLY", 
        logoTextSecondary: "SAAS",
        description: "La solución líder para crear tu tienda virtual en minutos y recibir pedidos directamente en tu WhatsApp.",
        siteUrl: "https://vendly-20w.pages.dev"
    },
    seo: {
        title: "Vendly | Crea tu Tienda Online y Vende por WhatsApp en Minutos",
        description: "Vendly te permite crear tu catálogo virtual interactivo, sincronizar tasa BCV en tiempo real y recibir pedidos directamente a WhatsApp sin comisiones.",
        keywords: "tienda online venezuela, catalogo whatsapp, pedidos whatsapp, ecommerce venezuela, vendly, tasa bcv",
        schemaType: "SoftwareApplication",
        priceRange: "$"
    },
    nav: {
        links: [
            { label: "Características", href: "#features" },
            { label: "Planes", href: "/precios" },
            { label: "Demos", href: "#demos" },
            { label: "Acceder", href: "/login" },
            { label: "Crear Tienda", href: "/register" }
        ]
    }
};
import '../styles/landing.css';
---

<BaseLayout 
  config={saasConfig} 
  title="Vendly | Crea tu Tienda Online y Vende por WhatsApp en Minutos"
  description="Vendly te permite crear tu catálogo virtual interactivo, sincronizar tasa BCV en tiempo real y recibir pedidos directamente a WhatsApp sin comisiones."
>
  <Header config={saasConfig} />
  <main>
    <!-- Hero Section con alto contraste garantizado -->
    <section class="saas-hero">
      <div class="saas-hero-container">
        <div class="saas-hero-content">
          <div class="badge-wrapper">
            <span class="badge">🚀 Lanzamiento 2026 · SaaS E-commerce</span>
          </div>
          <h1>
            Crea tu tienda online y vende por <span class="highlight">WhatsApp</span> en minutos
          </h1>
          <p class="hero-description">
            Vendly es la plataforma todo en uno para emprendedores y comercios. Gestiona inventario en vivo, recibe pagos multimoneda y automatiza tus ventas sin comisiones por transacción.
          </p>
          <div class="saas-hero-actions">
            <a href="/register" class="btn-primary-glow">
              <span>Comienza Gratis</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="#demos" class="btn-glass">
              <span>Ver Demos en Vivo</span>
            </a>
          </div>
          <div class="saas-hero-stats">
            <div class="stat-item">
              <strong class="stat-number">+500</strong>
              <span class="stat-label">Tiendas Creadas</span>
            </div>
            <div class="stat-separator"></div>
            <div class="stat-item">
              <strong class="stat-number">0%</strong>
              <span class="stat-label">Comisiones de Venta</span>
            </div>
            <div class="stat-separator"></div>
            <div class="stat-item">
              <strong class="stat-number">100%</strong>
              <span class="stat-label">Tasa BCV Oficial</span>
            </div>
          </div>
        </div>

        <div class="saas-hero-visual">
          <!-- Vista previa interactiva de la App / Dashboard -->
          <div class="mockup-window">
            <div class="mockup-header">
              <div class="dots-group">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <div class="mockup-address-bar">
                <span>🔒 tu-tienda.vendly.app</span>
              </div>
            </div>
            <div class="mockup-body">
              <div class="mockup-sidebar">
                <div class="sidebar-brand">
                  <div class="brand-circle"></div>
                  <span class="brand-text">Panel Control</span>
                </div>
                <div class="sidebar-item active">📦 Catálogo</div>
                <div class="sidebar-item">💬 Pedidos</div>
                <div class="sidebar-item">💱 Tasa BCV</div>
                <div class="sidebar-item">⚙️ Ajustes</div>
              </div>
              <div class="mockup-content">
                <div class="mockup-top-metrics">
                  <div class="mini-card metric-card">
                    <span class="metric-title">Ventas Hoy</span>
                    <strong class="metric-value">$348.50</strong>
                    <span class="metric-change positive">↑ 18.2%</span>
                  </div>
                  <div class="mini-card metric-card">
                    <span class="metric-title">Pedidos WhatsApp</span>
                    <strong class="metric-value">24 Nuevos</strong>
                    <span class="metric-badge">Pendientes</span>
                  </div>
                </div>
                
                <div class="mini-card mockup-order-preview">
                  <div class="order-preview-header">
                    <span class="order-tag">Pedido #1084</span>
                    <span class="order-time">Hace 3 min</span>
                  </div>
                  <div class="order-preview-item">
                    <div class="order-item-img"></div>
                    <div class="order-item-details">
                      <strong>Combo Burger Especial (x2)</strong>
                      <span>Cliente: Carlos Méndez · Pago Móvil</span>
                    </div>
                    <span class="order-price">$26.50</span>
                  </div>
                </div>

                <div class="mockup-action-banner">
                  <span>🚀 WhatsApp conectado: Envíos instantáneos activos</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section (Grid 2x2 equilibrado) -->
    <section id="features" class="saas-features">
      <div class="container">
        <div class="section-header">
          <span class="section-sub">POTENCIA Y SIMPLICIDAD</span>
          <h2>Todo lo que necesitas para escalar tus ventas</h2>
          <p>Diseñado especialmente para el comercio moderno: rápido, sin fricciones y adaptado a la realidad multimoneda.</p>
        </div>
        
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-2 2.5h3L11 9h3l-5 13 3-9H9l2-4.5H8L13 2z"/></svg>
            </div>
            <h3>Despliegue en 60 Segundos</h3>
            <p>Tu catálogo web listo al instante sin saber programar. Sube fotos, precios y empieza a compartir tu enlace en Instagram y WhatsApp.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            </div>
            <h3>Pedidos Directos a WhatsApp</h3>
            <p>Tus clientes arman el carrito de compras con total claridad y recibes el pedido desglosado con datos de entrega y comprobante de pago.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#06B6D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>
            </div>
            <h3>Panel de Control & Inventario</h3>
            <p>Supervisa órdenes en tiempo real, marca pedidos como confirmados o entregados, y mantén el stock sincronizado sin complicaciones.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><line x1="3" x2="6" y1="3" y2="6"/><line x1="21" x2="18" y1="3" y2="6"/><line x1="3" x2="6" y1="21" y2="18"/><line x1="21" x2="18" y1="21" y2="18"/></svg>
            </div>
            <h3>Multimoneda & Tasa BCV Oficial</h3>
            <p>Sincronización automática con la tasa del Banco Central de Venezuela. Tus clientes pagan en Bolívares (Pago Móvil) o en Dólares sin enredos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Demos Section con miniaturas reales -->
    <section id="demos" class="saas-demos">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-sub">PLANTILLAS ULTRA OPTIMIZADAS</span>
          <h2>Diseños adaptados a tu tipo de negocio</h2>
          <p>Explora nuestras tiendas interactivas pre-configuradas. Prueba la experiencia de compra de tus clientes.</p>
        </div>
        
        <div class="demos-grid">
          <a href="/demo/restaurant" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-image-container">
              <img src="/assets/hero_grill.webp" alt="Plantilla Restaurante" class="demo-img" loading="lazy" />
              <div class="demo-badge">Comida & Delivery</div>
            </div>
            <div class="demo-info">
              <div class="demo-title-row">
                <h3>Restaurante y Comida</h3>
                <span class="demo-arrow">→</span>
              </div>
              <p>Ideal para hamburgueserías, pizzerías, comida rápida y menús ejecutivos con opciones de delivery.</p>
            </div>
          </a>
          
          <a href="/demo/tech" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-image-container">
              <img src="/assets/product_laptop.webp" alt="Plantilla Tecnología" class="demo-img" loading="lazy" />
              <div class="demo-badge">Tecnología</div>
            </div>
            <div class="demo-info">
              <div class="demo-title-row">
                <h3>Electrónica y Gaming</h3>
                <span class="demo-arrow">→</span>
              </div>
              <p>Diseño futurista perfecto para smartphones, computación, periféricos gamer y accesorios de audio.</p>
            </div>
          </a>
          
          <a href="/demo/fashion" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-image-container">
              <img src="/assets/hero_fashion.webp" alt="Plantilla Moda" class="demo-img" loading="lazy" />
              <div class="demo-badge">Moda & Estilo</div>
            </div>
            <div class="demo-info">
              <div class="demo-title-row">
                <h3>Boutique y Ropa</h3>
                <span class="demo-arrow">→</span>
              </div>
              <p>Estética refinada pensada para catálogos de prendas, vestidos, calzado y colecciones de temporada.</p>
            </div>
          </a>
          
          <a href="/demo/hardware" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-image-container">
              <img src="/assets/product_taladro.webp" alt="Plantilla Ferretería" class="demo-img" loading="lazy" />
              <div class="demo-badge">Ferretería & Construcción</div>
            </div>
            <div class="demo-info">
              <div class="demo-title-row">
                <h3>Ferretería y Taller</h3>
                <span class="demo-arrow">→</span>
              </div>
              <p>Estructura industrial para catálogo masivo de herramientas, plomería, electricidad y materiales.</p>
            </div>
          </a>

          <a href="/demo/autoparts" class="demo-card" target="_blank" rel="noopener">
            <div class="demo-image-container">
              <img src="/assets/product_frenos.webp" alt="Plantilla Repuestos Automotrices" class="demo-img" loading="lazy" />
              <div class="demo-badge">Repuestos Automotrices</div>
            </div>
            <div class="demo-info">
              <div class="demo-title-row">
                <h3>Auto Periquitos</h3>
                <span class="demo-arrow">→</span>
              </div>
              <p>Ideal para ventas de repuestos, accesorios, lubricantes y baterías con búsqueda especializada.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Pricing Callout -->
    <section class="saas-pricing-teaser">
      <div class="container teaser-box">
        <div class="teaser-text">
          <h3>Planes claros y accesibles desde $10/mes</h3>
          <p>Comienza hoy mismo sin compromisos a largo plazo ni comisiones por ventas. Cancela cuando quieras.</p>
        </div>
        <div class="teaser-action">
          <a href="/precios" class="btn-primary-glow">Ver Todos los Planes</a>
        </div>
      </div>
    </section>

    <!-- CTA Final Section -->
    <section class="saas-cta">
      <div class="cta-container">
        <h2>¿Listo para multiplicar las ventas de tu negocio?</h2>
        <p>Crea tu tienda ahora en minutos y ofrece la mejor experiencia de compra a tus clientes por WhatsApp.</p>
        <div class="cta-actions">
          <a href="/register" class="btn-cta-white">Crear Mi Tienda Ahora</a>
          <a href="/login" class="btn-cta-secondary">Ya tengo cuenta · Iniciar Sesión</a>
        </div>
      </div>
    </section>
  </main>
  <Footer config={saasConfig} />
</BaseLayout>


