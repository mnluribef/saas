---
// ProductCatalog.astro
// Carga productos de la API y renderiza el catálogo + carrito dinámico.
import type { StoreConfig } from '../../types/store.types';
import defaultStoreConfig from '../../config/store.config';

export interface Props {
  config?: StoreConfig;
}

const { config = defaultStoreConfig } = Astro.props;
const { catalog } = config.landing;
const { business, contact, features } = config;
---

<!-- Filtros de Categorías -->
<section id="menu">
    <div class="container">
        <div class="section-header reveal">
            <h2>
                {catalog.title} <span>{catalog.titleHighlight}</span>
            </h2>
            <p>
                {catalog.subtitle}
            </p>
        </div>
        <div
            class="search-container reveal"
            style="margin: 0 auto 2rem; max-width: 500px; padding: 0 1rem;"
        >
            <div style="position: relative;">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    style="position: absolute; left: 1.2rem; top: 50%; transform: translateY(-50%); color: var(--text-light);"
                >
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
                <input
                    type="text"
                    id="product-search"
                    placeholder={catalog.searchPlaceholder}
                    style="width: 100%; padding: 0.9rem 3.2rem 0.9rem 3.2rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 50px; font-size: 1rem; outline: none; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(0,0,0,0.03); font-family: 'Outfit', sans-serif;"
                />
                <button
                    id="clear-search"
                    aria-label="Limpiar búsqueda"
                    style="position: absolute; right: 1.2rem; top: 50%; transform: translateY(-50%); display: none; background: none; border: none; cursor: pointer; color: var(--text-light); padding: 0; align-items: center; justify-content: center;"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
        </div>

        <div
            class="category-filters-container reveal"
            style="margin-bottom: 2.5rem; display: flex; justify-content: center;"
        >
            <div
                class="category-filters"
                id="category-filters"
                style="display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center;"
            >
                <!-- Se cargará dinámicamente con JavaScript -->
            </div>
        </div>

        <div class="product-grid" id="catalog-container">
            <!-- Loading state -->
            <div
                class="loading-catalog"
                style="grid-column: 1/-1; text-align: center; padding: 3rem 0; color: var(--text-secondary);"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="spin"
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    style="margin-bottom: 1rem;"
                >
                    <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                </svg>
                <p>Cargando menú...</p>
            </div>
        </div>

        <div
            id="load-more-container"
            style="text-align: center; margin-top: 3rem; display: none;"
        >
            <button id="load-more-btn" class="btn-outline-dark">
                Ver Más Productos
            </button>
        </div>
    </div>
</section>

<!-- Cart Drawer -->
<div id="cart-overlay" class="cart-overlay"></div>
<div id="cart-drawer" class="cart-drawer">
    <div class="cart-header">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <button
                id="cart-back-btn"
                aria-label="Volver"
                style="display: none; background: rgba(255,255,255,0.15); border: none; cursor: pointer; color: var(--white); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: var(--transition);"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>
            <h3 id="cart-title" style="margin: 0;">
                {config.labels?.cartTitle || "🛒 Tu Pedido"}
            </h3>
        </div>
        <div class="cart-header-actions">
            <button
                id="clear-cart"
                class="clear-cart-btn"
                title="Vaciar Carrito"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M3 6h18" />
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                    <line x1="10" x2="10" y1="11" y2="17" />
                    <line x1="14" x2="14" y1="11" y2="17" />
                </svg>
            </button>
            <button id="close-cart" aria-label="Cerrar carrito">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
    </div>
    <div
        id="cart-step-1"
        class="cart-step active"
        style="display: flex; flex-direction: column; flex: 1; overflow: hidden;"
    >
        <div
            id="cart-items"
            class="cart-items"
            style="flex: 1; overflow-y: auto;"
        >
            <div class="empty-cart-msg">{config.labels?.emptyCartEmoji || "🛒"} Tu pedido está vacío</div>
        </div>
    </div>

    <div
        id="cart-step-2"
        class="cart-step"
        style="display: none; flex-direction: column; flex: 1; overflow-y: auto; padding: 1.2rem 1.5rem; background: rgba(0,0,0,0.015); scrollbar-width: thin; scrollbar-color: var(--rose-light) transparent;"
    >
        <h4 style="margin-bottom: 0.75rem; color: var(--text-dark); font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; font-family: 'Outfit', sans-serif;">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--accent)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            Datos de Contacto
        </h4>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 200px;">
                <label
                    for="client-name"
                    style="display: block; font-size: 0.75rem; margin-bottom: 0.3rem; color: var(--text-light); font-weight: 600;"
                >
                    Nombre Completo
                </label>
                <input
                    type="text"
                    id="client-name"
                    placeholder="Ej. María González"
                    maxlength="100"
                    style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; background: #fff; color: var(--text-dark); outline: none; font-size: 0.9rem; transition: border-color 0.2s;"
                />
            </div>
            <div style="flex: 1; min-width: 200px;">
                <label
                    for="client-phone"
                    style="display: block; font-size: 0.75rem; margin-bottom: 0.3rem; color: var(--text-light); font-weight: 600;"
                >
                    Teléfono / WhatsApp
                </label>
                <input
                    type="tel"
                    id="client-phone"
                    placeholder="Ej. +58 412-4756191"
                    maxlength="30"
                    style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; background: #fff; color: var(--text-dark); outline: none; font-size: 0.9rem; transition: border-color 0.2s;"
                />
            </div>
        </div>

        <div style="width: 100%; margin-top: 1.2rem;">
            <label style="display: block; font-size: 0.75rem; margin-bottom: 0.5rem; color: var(--text-light); font-weight: 600;">
                Opciones de Entrega
            </label>
            <div style="display: flex; gap: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; cursor: pointer; color: var(--text-dark);">
                    <input
                        type="radio"
                        name="delivery-type"
                        value="retiro"
                        checked
                        style="accent-color: var(--accent);"
                    />{" "}
                    🏪 {config.labels?.pickupOptionName || "Retiro en local"}
                </label>
                <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; cursor: pointer; color: var(--text-dark);">
                    <input
                        type="radio"
                        name="delivery-type"
                        value="delivery"
                        style="accent-color: var(--accent);"
                    />{" "}
                    🛵 {config.labels?.deliveryOptionName || "Delivery"} (+${config.labels?.deliveryOptionPrice ?? 5})
                </label>
            </div>
        </div>

        <div
            id="delivery-address-container"
            style="width: 100%; margin-top: 1rem; display: none;"
        >
            <label
                for="delivery-address"
                style="display: block; font-size: 0.75rem; margin-bottom: 0.3rem; color: var(--text-light); font-weight: 600;"
            >
                Dirección de Entrega
            </label>
            <input
                type="text"
                id="delivery-address"
                placeholder="Ej. Calle 5, Res. Los Mangos, Apto 4"
                maxlength="300"
                style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; background: #fff; color: var(--text-dark); outline: none; font-size: 0.9rem; transition: border-color 0.2s;"
            />
        </div>
    </div>

    <div
        id="cart-step-3"
        class="cart-step"
        style="display: none; flex-direction: column; flex: 1; overflow-y: auto; padding: 1.2rem 1.5rem; background: rgba(0,0,0,0.015); scrollbar-width: thin; scrollbar-color: var(--rose-light) transparent;"
    >
        <div style="width: 100%;">
            <label
                for="payment-method"
                style="display: block; font-size: 0.75rem; margin-bottom: 0.5rem; color: var(--text-light); font-weight: 600;"
            >
                Método de Pago
            </label>
            <select
                id="payment-method"
                style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; background: #fff; color: var(--text-dark); outline: none; font-size: 0.9rem; transition: border-color 0.2s; appearance: auto;"
            >
                <option value="" disabled selected>
                    Selecciona un método...
                </option>
                <option value="pago_movil">📱 Pago Móvil</option>
                <option value="zelle">🇺🇸 Zelle</option>
                <option value="efectivo">💵 Efectivo (Divisas / Bs)</option>
                <option value="punto">💳 Punto de Venta (Sólo Retiro)</option>
            </select>
        </div>

        <!-- Payment info panels -->
        <div
            id="payment-info-pago-movil"
            style="display: none; width: 100%; margin-top: 0.8rem; padding: 0.8rem; background: rgba(0,0,0,0.03); border-radius: 8px; font-size: 0.85rem; border: 1px solid rgba(0,0,0,0.05);"
        >
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <p style="margin:0; font-weight:600; color:var(--text-dark);">Datos para Pago Móvil:</p>
                <button type="button" id="copy-pm-btn" style="background: var(--primary-light, rgba(0,0,0,0.05)); color: var(--primary); border: none; padding: 0.2rem 0.6rem; border-radius: 5px; font-size: 0.75rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.3rem; transition: background 0.2s;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    Copiar
                </button>
            </div>
            <ul style="margin:0; padding-left:1.2rem; color:var(--text-light);">
                <li>
                    <strong>Banco:</strong> <span id="pm-data-banco">{config.payment?.pagoMovil?.banco || "Banesco (0134)"}</span>
                </li>
                <li>
                    <strong>Teléfono:</strong> <span id="pm-data-telefono">{config.payment?.pagoMovil?.telefono || contact.phone || "0412-4756191"}</span>
                </li>
                <li>
                    <strong>C.I / RIF:</strong> <span id="pm-data-cedula">{config.payment?.pagoMovil?.cedula || "V-12345678"}</span>
                </li>
            </ul>
            <div style="margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed rgba(0,0,0,0.1); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.2rem;">
                <div>
                    <span style="color: var(--text-dark); font-weight: 600;">Monto Exacto a Transferir:</span>
                    <strong id="pago-movil-bs-amount" style="color: var(--accent); margin-left: 0.3rem; font-size: 0.95rem;">Bs. 0,00</strong>
                </div>
                <span style="font-size: 0.72rem; color: var(--text-light);">
                    Calculado con Tasa Oficial BCV: <strong class="bcv-rate-text">--</strong> Bs/$
                </span>
            </div>
        </div>

        <div
            id="payment-info-zelle"
            style="display: none; width: 100%; margin-top: 0.8rem; padding: 0.8rem; background: rgba(0,0,0,0.03); border-radius: 8px; font-size: 0.85rem; border: 1px solid rgba(0,0,0,0.05);"
        >
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <p style="margin:0; font-weight:600; color:var(--text-dark);">Datos para Zelle:</p>
                <button type="button" id="copy-zelle-btn" style="background: var(--primary-light, rgba(0,0,0,0.05)); color: var(--primary); border: none; padding: 0.2rem 0.6rem; border-radius: 5px; font-size: 0.75rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.3rem; transition: background 0.2s;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    Copiar
                </button>
            </div>
            <ul style="margin:0; padding-left:1.2rem; color:var(--text-light);">
                <li>
                    <strong>Correo:</strong> <span id="zelle-data-email">{config.payment?.zelle?.email || contact.email || "pagos@vendly.com"}</span>
                </li>
                <li>
                    <strong>Titular:</strong> <span id="zelle-data-titular">{config.payment?.zelle?.titular || business.name}</span>
                </li>
            </ul>
        </div>

        <div
            id="payment-reference-container"
            style="display: none; width: 100%; margin-top: 1rem;"
        >
            <label
                for="payment-reference"
                style="display: block; font-size: 0.75rem; margin-bottom: 0.3rem; color: var(--text-light); font-weight: 600;"
            >
                Número de Referencia
            </label>
            <input
                type="text"
                id="payment-reference"
                placeholder="Ej. 123456"
                maxlength="100"
                style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; background: #fff; color: var(--text-dark); outline: none; font-size: 0.9rem; transition: border-color 0.2s;"
            />
        </div>

        <!-- Carga de Comprobante de Pago -->
        <div
            id="payment-receipt-container"
            style="display: none; width: 100%; margin-top: 1rem;"
        >
            <label
                style="display: block; font-size: 0.75rem; margin-bottom: 0.3rem; color: var(--text-light); font-weight: 600;"
            >
                📸 Comprobante de Pago (Captura o Foto)
            </label>
            <div
                id="receipt-dropzone"
                style="border: 2px dashed var(--border-focus, var(--primary)); border-radius: 10px; padding: 0.8rem; text-align: center; cursor: pointer; background: var(--primary-light, rgba(0,0,0,0.04)); transition: all 0.2s ease;"
            >
                <input
                    type="file"
                    id="payment-receipt-file"
                    accept="image/jpeg,image/png,image/webp"
                    style="display: none;"
                />
                <div id="receipt-prompt">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="color: var(--primary); margin: 0 auto 0.3rem;"
                    >
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                    <p style="font-size: 0.8rem; font-weight: 600; margin: 0; color: var(--text-dark);">
                        Subir captura del comprobante
                    </p>
                    <span style="font-size: 0.7rem; color: var(--text-light);">
                        JPG, PNG, WebP (Optimizado automáticamente)
                    </span>
                </div>
                <div
                    id="receipt-preview-box"
                    style="display: none; align-items: center; justify-content: space-between; gap: 0.6rem;"
                >
                    <div style="display: flex; align-items: center; gap: 0.6rem; overflow: hidden;">
                        <img
                            id="receipt-preview-img"
                            src=""
                            alt="Comprobante"
                            style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(0,0,0,0.1);"
                        />
                        <div style="text-align: left; overflow: hidden;">
                            <span
                                id="receipt-preview-name"
                                style="font-size: 0.78rem; font-weight: 600; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px;"
                            >
                                comprobante.jpg
                            </span>
                            <span style="font-size: 0.7rem; color: var(--success); font-weight: 500;">
                                ✓ Adjunto con éxito
                            </span>
                        </div>
                    </div>
                    <button
                        type="button"
                        id="btn-remove-receipt"
                        style="background: rgba(239,68,68,0.12); color: #ef4444; border: none; border-radius: 6px; padding: 0.35rem 0.55rem; font-size: 0.75rem; cursor: pointer; font-weight: 600;"
                    >
                        Quitar
                    </button>
                </div>
            </div>

            <!-- Cupón de Descuento Promocional -->
            <div id="cart-coupon-section" style="width: 100%; margin-top: 1rem; padding: 0.8rem; background: rgba(0,0,0,0.03); border: 1px dashed rgba(0,0,0,0.12); border-radius: 8px;">
                <label for="cart-coupon-input" style="display: block; font-size: 0.75rem; margin-bottom: 0.35rem; color: var(--text-light); font-weight: 600;">
                    ¿Tienes un cupón de descuento?
                </label>
                <div style="display: flex; gap: 0.5rem;">
                    <input
                        type="text"
                        id="cart-coupon-input"
                        placeholder="Ej. PROMO10"
                        style="flex: 1; text-transform: uppercase; padding: 0.5rem 0.75rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 6px; font-size: 0.85rem;"
                    />
                    <button
                        type="button"
                        id="btn-apply-coupon"
                        style="padding: 0.5rem 0.9rem; background: var(--primary); color: white; border: none; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer;"
                    >
                        Aplicar
                    </button>
                </div>
                <div id="cart-coupon-msg" style="display: none; font-size: 0.75rem; margin-top: 0.4rem;"></div>
            </div>
        </div>
    </div>

    <div id="cart-total-fixed">
        <div style="display: flex; flex-direction: column;">
            <span>Total:</span>
            <span id="cart-discount-label" style="display: none; font-size: 0.75rem; color: var(--success); font-weight: 600;"></span>
        </div>
        <div class="cart-total-values">
            <div id="cart-total-amount">
                $0.00
            </div>
            <div id="cart-total-bs">
                ≈ Bs. 0,00
            </div>
        </div>
    </div>

    <div class="cart-footer">
        <button
            id="cart-next-btn"
            class="cta-btn cart-next-btn"
            disabled
        >
            Continuar (Datos)
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m9 18 6-6-6-6" />
            </svg>
        </button>
        <button
            id="whatsapp-order-btn"
            class="cta-btn whatsapp-btn"
            style="display: none;"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="display:inline; margin-right:6px;"
            >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            Enviar Pedido por WhatsApp
        </button>
    </div>
</div>

<!-- Floating Cart -->
<button id="cart-btn" class="float-cart" aria-label="Ver carrito">
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
