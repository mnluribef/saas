---
// Hero.astro - Sección Hero y Estadísticas configurable
import type { StoreConfig } from '../../types/store.types';
import defaultStoreConfig from '../../config/store.config';

export interface Props {
  config?: StoreConfig;
}

const { config = defaultStoreConfig } = Astro.props;
const { hero } = config.landing;
---

<!-- Hero Section -->
<section class="hero-full">
  <div class="hero-slider">
    {hero.slides.map((slide, index) => {
      const slideImg = slide.image && (slide.image.startsWith('http') || slide.image.startsWith('/')) ? slide.image : `/${slide.image || 'assets/favicon.svg'}`;
      return (
        <div class={`slide ${index === 0 ? 'active' : ''}`}>
          <img
            src={slideImg}
            alt={slide.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </div>
      );
    })}
  </div>
  <div class="hero-full-container">
    <div class="hero-content">
      <p class="hero-label">
        <span>{hero.badgeText}</span>
      </p>
      <h1>{hero.headline} <em>{hero.headlineHighlight}</em></h1>
      <p>{hero.subheadline}</p>

      {hero.ctaPrimaryText && (
        <div style="margin-top: 1.8rem; display: flex; gap: 1rem; flex-wrap: wrap;">
          <a
            href={hero.ctaPrimaryLink}
            class="btn btn-primary"
            style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.85rem 1.8rem; border-radius: 50px; font-weight: 600; font-size: 1rem; background: var(--grad-cta); color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.2s ease;"
          >
            <span>{hero.ctaPrimaryText}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          {hero.ctaSecondaryText && hero.ctaSecondaryLink && (
            <a
              href={hero.ctaSecondaryLink}
              target={hero.ctaSecondaryLink.startsWith('http') ? '_blank' : '_self'}
              rel={hero.ctaSecondaryLink.startsWith('http') ? 'noopener' : ''}
              class="btn btn-secondary"
              style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.85rem 1.8rem; border-radius: 50px; font-weight: 600; font-size: 1rem; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); color: #fff; border: 1px solid rgba(255,255,255,0.3); transition: all 0.2s ease;"
            >
              <span>{hero.ctaSecondaryText}</span>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<!-- Trust Stats Section -->
{hero.stats && hero.stats.length > 0 && (
  <section class="stats-section bg-primary-light">
    <div class="container">
      <div class="stats-grid">
        {hero.stats.map((stat) => (
          <div class="stat-item reveal">
            <h3>{stat.value}</h3>
            <p>{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  // Hero Slider
  const slides = document.querySelectorAll<HTMLElement>('.slide');
  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('active');
    }, 5000);
  }
</script>
