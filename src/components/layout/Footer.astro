---
// Footer.astro - Pie de página configurable
import type { StoreConfig } from '../../types/store.types';
import defaultStoreConfig from '../../config/store.config';

export interface Props {
  config?: StoreConfig;
}

const { config = defaultStoreConfig } = Astro.props;
const { business, contact, nav } = config;
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-info">
        <div class="footer-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {config.template === 'restaurant' && (
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
            )}
            {config.template === 'hardware' && (
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            )}
            {config.template === 'fashion' && (
              <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" />
            )}
            {config.template === 'autoparts' && (
              <>
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.1 2 11.5 2 12v4c0 .6.4 1 1 1h2" />
                <circle cx="7" cy="17" r="2" />
                <path d="M9 17h6" />
                <circle cx="17" cy="17" r="2" />
              </>
            )}
            {config.template === 'tech' && (
              <>
                <rect width="16" height="16" x="4" y="4" rx="2" />
                <rect width="6" height="6" x="9" y="9" rx="1" />
                <path d="M15 2v2" />
                <path d="M15 20v2" />
                <path d="M2 15h2" />
                <path d="M2 9h2" />
                <path d="M20 15h2" />
                <path d="M20 9h2" />
                <path d="M9 2v2" />
                <path d="M9 20v2" />
              </>
            )}
          </svg>
          <span class="logo-text">{business.logoTextPrimary}<span>{business.logoTextSecondary || ''}</span></span>
        </div>
        <p>{business.description}</p>
        <p class="footer-hours">🕐 {contact.hours}</p>
        {contact.instagram && (
          <div class="footer-social">
            <a href={contact.instagram} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="#E4405F">
                <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.984 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.066.935 20.398.524 19.61.21 18.844.333 17.974.131 16.697.072 15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.58.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.27.07 1.646.07 4.85s-.015 3.58-.07 4.85c-.055 1.17-.249 1.805-.413 2.227-.217.562-.477.96-.896 1.382-.42.419-.819.679-1.381.896-.422.164-1.057.36-2.227.413-1.28.057-1.656.07-4.86.07zm0 5.84a4 4 0 100 8 4 4 0 000-8zm0 6.16a2.16 2.16 0 110-4.32 2.16 2.16 0 010 4.32zm6.406-7.08a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/>
              </svg>
            </a>
          </div>
        )}
      </div>

      <div class="footer-links">
        <h4>Navegación</h4>
        <ul>
          {nav.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links">
        <h4>Contacto</h4>
        <ul>
          {contact.whatsapp && (
            <li>
              <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener" class="footer-contact-link">
                <svg class="footer-icon-svg" viewBox="0 0 24 24" width="16" height="16" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                {contact.whatsappDisplay || `+${contact.whatsapp}`}
              </a>
            </li>
          )}
          {contact.instagramHandle && contact.instagram && (
            <li>
              <a href={contact.instagram} target="_blank" rel="noopener" class="footer-contact-link">
                <svg class="footer-icon-svg" viewBox="0 0 24 24" width="16" height="16" fill="#E4405F"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.984 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.066.935 20.398.524 19.61.21 18.844.333 17.974.131 16.697.072 15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.58.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.27.07 1.646.07 4.85s-.015 3.58-.07 4.85c-.055 1.17-.249 1.805-.413 2.227-.217.562-.477.96-.896 1.382-.42.419-.819.679-1.381.896-.422.164-1.057.36-2.227.413-1.28.057-1.656.07-4.86.07zm0 5.84a4 4 0 100 8 4 4 0 000-8zm0 6.16a2.16 2.16 0 110-4.32 2.16 2.16 0 010 4.32zm6.406-7.08a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/></svg>
                {contact.instagramHandle}
              </a>
            </li>
          )}
          {contact.address && (
            <li>
              <span class="footer-contact-link">
                <svg class="footer-icon-svg" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {contact.address}
              </span>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {business.name}. Todos los derechos reservados.</p>
      <p class="dev-credit">Hecho por <a href="https://manueluribe.dev" target="_blank" rel="noopener">Manuel Uribe</a></p>
    </div>
  </div>
</footer>


<style is:global>
/* ===================== FOOTER ===================== */
footer {
    background: linear-gradient(160deg, var(--hero-bg) 0%, #030712 100%);
    color: rgba(255, 255, 255, 0.75);
    padding: 5rem 0 2.5rem;
    position: relative;
    overflow: hidden;
}

footer::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold), transparent);
}

/* Decoración de fondo */
footer::after {
    content: '';
    position: absolute;
    bottom: -1.5rem;
    right: 3%;
    pointer-events: none;
    user-select: none;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem;
    margin-bottom: 3rem;
}

.footer-logo {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    color: var(--white);
}

.footer-logo svg,
.footer-logo i {
    margin-right: 0.45rem;
}

.footer-logo span,
.footer-logo .logo-text span {
    color: rgba(245, 230, 200, 0.7);
    font-style: italic;
    margin-left: 0;
}

.footer-info > p {
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 280px;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 1.2rem;
}

.footer-hours {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
}

.footer-social {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.2rem;
}

.footer-social a {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.footer-social a:hover {
    background: var(--rose);
    border-color: var(--rose);
    transform: translateY(-3px);
}

.footer-links h4 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    position: relative;
    display: inline-block;
}

.footer-links h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 22px;
    height: 2px;
    background: var(--rose, #FFFFFF);
    border-radius: 2px;
}

.footer-links ul li {
    margin-bottom: 0.85rem;
}

.footer-links ul li a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    transition: color 0.25s, transform 0.25s;
    display: inline-block;
    text-decoration: none;
}

.footer-links ul li a:hover {
    color: #FFFFFF;
    transform: translateX(4px);
}

.footer-contact-link {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.88);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.25s, transform 0.25s;
    text-decoration: none;
}

a.footer-contact-link:hover {
    color: #FFFFFF;
    transform: translateX(3px);
}

.footer-icon-svg {
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.5rem;
    flex-shrink: 0;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.65);
}

.dev-credit a {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    transition: color 0.25s;
}

.dev-credit a:hover {
    color: #FFFFFF;
    text-decoration: underline;
}
</style>
