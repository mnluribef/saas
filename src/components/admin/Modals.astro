---
// src/components/admin/Modals.astro
---
<!-- Modal Detalles Pedido -->
<div class="modal" id="order-detail-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modal-order-title">
                Detalles del Pedido #FOG-XXXX
            </h3>
            <button class="modal-close" id="btn-close-modal">
                <i data-lucide="x"></i>
            </button>
        </div>

        <div class="modal-body" id="modal-order-body">
            <!-- Información del Cliente -->
            <div class="order-meta-info">
                <div>
                    <p>Cliente</p>
                    <strong id="modal-client-name">-</strong>
                </div>
                <div>
                    <p>Contacto WhatsApp</p>
                    <strong id="modal-client-phone">-</strong>
                </div>
                <div>
                    <p>Fecha de Solicitud</p>
                    <strong id="modal-order-date">-</strong>
                </div>
                <div>
                    <p>Estado del Pedido</p>
                    <strong style="margin-top: 0.2rem;">
                        <span
                            id="modal-order-status"
                            class="status-badge pendiente"
                        >
                            Pendiente
                        </span>
                    </strong>
                </div>
                <div>
                    <p>Total del Pedido</p>
                    <strong
                        id="modal-order-total"
                        style="color: var(--accent); font-size: 1.15rem; margin-top: 0.2rem;"
                    >
                        -
                    </strong>
                    <span id="modal-order-total-bs" style="font-size: 0.82rem; color: var(--text-secondary); display: block; margin-top: 2px;"></span>
                </div>
            </div>

            <!-- Información de Entrega -->
            <h4 style="font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--white); margin-top: 0.5rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.4rem;">
                Información de Entrega
            </h4>
            <div
                class="order-meta-info"
                style="grid-template-columns: 1fr; gap: 0.6rem; margin-bottom: 1.2rem;"
            >
                <div>
                    <p>Método</p>
                    <strong id="modal-delivery-type">-</strong>
                </div>
                <div
                    id="modal-delivery-address-container"
                    style="display: none;"
                >
                    <p>Dirección</p>
                    <strong id="modal-delivery-address">-</strong>
                </div>
                <div
                    id="modal-delivery-notes-container"
                    style="display: none;"
                >
                    <p>Notas Adicionales</p>
                    <strong id="modal-delivery-notes">-</strong>
                </div>
            </div>

            <!-- Información de Pago -->
            <h4 style="font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--white); margin-top: 0.5rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.4rem;">
                Datos de Pago
            </h4>
            <div
                class="order-meta-info"
                style="grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 1.2rem;"
                id="modal-payment-info-container"
            >
                <div>
                    <p>Método de Pago</p>
                    <strong id="modal-payment-method">-</strong>
                </div>
                <div>
                    <p>Referencia</p>
                    <strong id="modal-payment-reference">-</strong>
                </div>
            </div>

            <!-- Comprobante de Pago Adjunto -->
            <div id="modal-receipt-container" style="display: none; background: rgba(15, 22, 42, 0.4); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; margin-bottom: 1.2rem;">
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.5rem; font-weight: 500;">
                    📸 Comprobante de Pago Adjunto:
                </p>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <img id="modal-receipt-thumb" src="" alt="Comprobante" style="width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color); cursor: pointer;" />
                    <div>
                        <button type="button" class="btn-action secondary" id="btn-view-receipt-modal" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                            <i data-lucide="eye"></i> Ver Comprobante Completo
                        </button>
                        <span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 4px;">Click para ampliar captura</span>
                    </div>
                </div>
            </div>

            <!-- Lista de Productos en Pedido -->
            <h4 style="font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--white); margin-bottom: 0.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.4rem;">
                Artículos Solicitados
            </h4>
            <div id="modal-items-list">
                <!-- Detalle cargado dinámicamente -->
            </div>
        </div>

        <div class="modal-footer">
            <button
                class="btn-action secondary"
                id="btn-modal-close-footer"
            >
                Cerrar
            </button>
            <a
                href=""
                target="_blank"
                class="btn-action"
                id="btn-modal-chat"
                style="background: #25D366; box-shadow: 0 4px 12px rgba(37,211,102,0.3);"
            >
                <i data-lucide="message-circle"></i> Chatear por
                WhatsApp
            </a>
        </div>
    </div>
</div>

<!-- Modal Registrar Pago -->
<div class="modal" id="payment-modal">
    <div class="modal-content" style="max-width: 480px;">
        <div class="modal-header">
            <h3>Registrar Pago</h3>
            <button class="modal-close" id="btn-close-payment-modal">
                <i data-lucide="x"></i>
            </button>
        </div>
        <form id="payment-form">
            <div class="modal-body" style="max-height: 300px;">
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
                    Pedido:{" "}
                    <strong
                        id="payment-modal-order-id"
                        style="color: var(--primary);"
                    ></strong>
                </p>
                <div class="form-group">
                    <label for="payment-amount">
                        Monto Cobrado ($)
                    </label>
                    <input
                        type="number"
                        id="payment-amount"
                        class="form-control"
                        placeholder="0.00"
                        step="0.01"
                        min="0"
                        required
                    />
                </div>
                <div class="form-group">
                    <label for="payment-method-select">
                        Método de Pago
                    </label>
                    <select
                        id="payment-method-select"
                        class="form-control"
                    >
                        <option value="pago_movil">
                            📱 Pago Móvil
                        </option>
                        <option value="zelle">🇺🇸 Zelle</option>
                        <option value="efectivo_usd">
                            💵 Efectivo USD
                        </option>
                        <option value="efectivo_bs">
                            💵 Efectivo Bs
                        </option>
                        <option value="punto">💳 Punto de Venta</option>
                    </select>
                </div>
                <div class="form-group" id="reference-group">
                    <label for="payment-reference">
                        Referencia / Confirmación
                    </label>
                    <input
                        type="text"
                        id="payment-reference"
                        class="form-control"
                        placeholder="Número de confirmación"
                    />
                </div>
            </div>
            <div class="modal-footer">
                <button
                    type="button"
                    class="btn-action secondary"
                    id="btn-cancel-payment-modal"
                >
                    Cancelar
                </button>
                <button
                    type="submit"
                    class="btn-action"
                    id="btn-confirm-payment"
                    style="background: var(--success); box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);"
                >
                    <i data-lucide="check-circle"></i> Confirmar Pago
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Cambiar Contraseña -->
<div class="modal" id="change-password-modal">
    <div class="modal-content" style="max-width: 440px;">
        <div class="modal-header">
            <h3>Cambiar Contraseña</h3>
            <button class="modal-close" id="btn-close-password-modal">
                <i data-lucide="x"></i>
            </button>
        </div>
        <form id="change-password-form">
            <div class="modal-body">
                <div class="form-group">
                    <label for="current-password-input">
                        Contraseña Actual
                    </label>
                    <input
                        type="password"
                        id="current-password-input"
                        class="form-control"
                        required
                        placeholder="••••••••"
                    />
                </div>
                <div class="form-group">
                    <label for="new-password-input">
                        Nueva Contraseña (mínimo 8 caracteres)
                    </label>
                    <input
                        type="password"
                        id="new-password-input"
                        class="form-control"
                        minlength="8"
                        required
                        placeholder="••••••••"
                    />
                </div>
                <div class="form-group">
                    <label for="confirm-password-input">
                        Confirmar Nueva Contraseña
                    </label>
                    <input
                        type="password"
                        id="confirm-password-input"
                        class="form-control"
                        minlength="8"
                        required
                        placeholder="••••••••"
                    />
                </div>
            </div>
            <div class="modal-footer">
                <button
                    type="button"
                    class="btn-action secondary"
                    id="btn-cancel-password-modal"
                >
                    Cancelar
                </button>
                <button
                    type="submit"
                    class="btn-action"
                    id="btn-submit-password"
                >
                    <i data-lucide="save"></i> Actualizar Clave
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Visor de Comprobante -->
<div class="modal" id="receipt-modal">
    <div class="modal-content" style="max-width: 600px; padding: 0;">
        <div class="modal-header" style="padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color);">
            <h3>Comprobante de Pago</h3>
            <button class="modal-close" id="btn-close-receipt-modal">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="modal-body" style="padding: 0; display: flex; justify-content: center; align-items: center; background: #0f172a; min-height: 300px; max-height: 70vh; overflow: hidden;">
            <img id="receipt-modal-img" src="" alt="Comprobante Completo" style="max-width: 100%; max-height: 70vh; object-fit: contain;" />
        </div>
        <div class="modal-footer" style="padding: 1rem 1.5rem; border-top: 1px solid var(--border-color);">
            <button type="button" class="btn-action secondary" id="btn-close-receipt-footer">Cerrar</button>
            <a href="#" id="receipt-download-btn" class="btn-action" target="_blank" download="comprobante.jpg">
                <i data-lucide="download"></i> Descargar
            </a>
        </div>
    </div>
</div>

<!-- Modal Configuración Tasa BCV -->
<div class="modal" id="bcv-modal">
    <div class="modal-content" style="max-width: 460px;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <i data-lucide="dollar-sign" style="color: var(--primary); width: 22px; height: 22px;"></i>
                <h3 style="margin: 0;">Configuración Tasa BCV</h3>
            </div>
            <button class="modal-close" id="btn-close-bcv-modal">
                <i data-lucide="x"></i>
            </button>
        </div>
        <form id="bcv-form">
            <div class="modal-body">
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.25rem; line-height: 1.5;">
                    Define el valor del dólar oficial utilizado para calcular los montos en Bolívares (Bs) en pedidos y catálogos.
                </p>

                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label for="bcv-rate-input" style="font-weight: 600; display: block; margin-bottom: 0.4rem;">
                        Tasa Activa (Bs. / USD)
                    </label>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input
                            type="number"
                            id="bcv-rate-input"
                            class="form-control"
                            step="0.01"
                            min="0.01"
                            required
                            placeholder="Ej: 853.50"
                            style="font-size: 1.1rem; font-weight: 700; color: var(--primary);"
                        />
                        <button
                            type="button"
                            class="btn-action secondary"
                            id="btn-force-bcv-sync"
                            title="Sincronizar en vivo con la API oficial del BCV"
                            style="white-space: nowrap; padding: 0.6rem 0.9rem; font-size: 0.85rem;"
                        >
                            <i data-lucide="refresh-cw"></i> Sincronizar
                        </button>
                    </div>
                    <span id="bcv-last-sync-label" style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px; display: block;">
                        Cargando estado...
                    </span>
                </div>

                <div class="form-group" style="margin-bottom: 0.5rem; background: rgba(255, 255, 255, 0.03); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
                    <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; margin: 0;">
                        <input
                            type="checkbox"
                            id="bcv-auto-toggle"
                            style="width: 18px; height: 18px; accent-color: var(--primary); cursor: pointer;"
                        />
                        <div>
                            <span style="display: block; font-weight: 600; color: var(--white); font-size: 0.9rem;">
                                Actualización Automática
                            </span>
                            <span style="display: block; font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">
                                Consulta periódicamente la API oficial para actualizar la tasa sin intervención manual.
                            </span>
                        </div>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button
                    type="button"
                    class="btn-action secondary"
                    id="btn-cancel-bcv"
                >
                    Cancelar
                </button>
                <button
                    type="submit"
                    class="btn-action"
                    style="background: var(--primary); box-shadow: 0 4px 12px rgba(201, 116, 138, 0.3);"
                >
                    <i data-lucide="save"></i> Guardar Configuración
                </button>
            </div>
        </form>
    </div>
</div>

