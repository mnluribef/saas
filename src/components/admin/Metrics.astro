---
// src/components/admin/Metrics.astro
---
<div id="section-metrics" class="dashboard-section active">
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-info">
                <h3>Ingresos Hoy</h3>
                <p id="metric-revenue">$0.00</p>
                <span id="metric-revenue-bs" class="metric-sub-val">≈ Bs 0.00</span>
            </div>
            <div class="metric-icon green">
                <i data-lucide="dollar-sign"></i>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-info">
                <h3>Ingresos Mes Actual</h3>
                <p id="metric-month-revenue">$0.00</p>
                <span id="metric-month-revenue-bs" class="metric-sub-val">≈ Bs 0.00</span>
                <div id="metric-growth-container"></div>
            </div>
            <div class="metric-icon blue">
                <i data-lucide="calendar"></i>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-info">
                <h3>Ticket Promedio</h3>
                <p id="metric-average-ticket">$0.00</p>
                <span id="metric-average-ticket-bs" class="metric-sub-val">≈ Bs 0.00</span>
            </div>
            <div class="metric-icon yellow">
                <i data-lucide="receipt"></i>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-info">
                <h3>Ventas Registradas</h3>
                <p id="metric-sales-count">0</p>
            </div>
            <div class="metric-icon blue">
                <i data-lucide="trending-up"></i>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-info">
                <h3>Pedidos Pendientes</h3>
                <p id="metric-pending-orders">0</p>
            </div>
            <div class="metric-icon yellow">
                <i data-lucide="clock"></i>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-info">
                <h3>Total Productos</h3>
                <p id="metric-prod-count">0</p>
            </div>
            <div class="metric-icon pink">
                <i data-lucide="package"></i>
            </div>
        </div>
    </div>
    
    <div class="content-card chart-card">
        <h2 class="chart-card-title">Tendencia de Ventas (7 Días)</h2>
        <div class="chart-wrapper">
            <canvas id="salesChart"></canvas>
        </div>
    </div>

    <!-- Sección de Analíticas Avanzadas -->
    <div class="analytics-row-grid">
        <div class="content-card">
            <div class="card-header">
                <h2>Top 5 Productos Más Vendidos</h2>
                <span class="badge-accent">Por Demanda</span>
            </div>
            <div id="top-products-container" class="top-products-list">
                <p class="analytics-empty-note">Cargando métricas de productos...</p>
            </div>
        </div>
        <div class="content-card">
            <div class="card-header">
                <h2>Canales de Pago & Entrega</h2>
                <span class="badge-accent">Distribución</span>
            </div>
            <div id="breakdown-container" class="breakdown-list">
                <p class="analytics-empty-note">Cargando canales de pago y entrega...</p>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header">
            <h2>Pedidos Recientes</h2>
            <button class="btn-action secondary view-all-orders-btn">
                Ver todos
            </button>
        </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID Pedido</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Artículos</th>
                        <th>Total</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="table-recent-orders">
                    <tr>
                        <td colspan="8" class="table-empty-cell">
                            Cargando pedidos recientes...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
