---
// src/components/admin/Sales.astro
---
<div id="section-sales" class="dashboard-section">
    <div class="content-card">
        <div class="card-header">
            <h2>
                Registro Histórico de Ventas{" "}
                <span
                    id="sales-total-amount"
                    class="header-success-badge"
                ></span>
            </h2>
            <div class="card-actions">
                <button
                    class="btn-action secondary"
                    id="btn-export-sales"
                    title="Exportar registro de ventas a archivo CSV / Excel"
                >
                    <i data-lucide="download"></i> Exportar CSV
                </button>
                <button
                    class="btn-action secondary"
                    id="btn-refresh-sales"
                >
                    <i data-lucide="refresh-cw"></i> Sincronizar
                </button>
            </div>
        </div>

        <!-- Barra de Búsqueda de Ventas -->
        <div class="table-toolbar-border">
            <div class="table-search-box">
                <input
                    type="text"
                    id="sales-search-input"
                    class="form-control table-search-input-padded"
                    placeholder="🔍 Buscar venta por cliente, método o #pedido..."
                />
            </div>
            <div class="date-filter-row">
                <label for="sales-date-from" class="date-label">Desde:</label>
                <input type="date" id="sales-date-from" class="form-control input-auto-width input-compact" />
                
                <label for="sales-date-to" class="date-label date-label-spacing">Hasta:</label>
                <input type="date" id="sales-date-to" class="form-control input-auto-width input-compact" />
                
                <button class="btn-action date-btn-spacing" id="btn-filter-sales-dates">
                    Filtrar
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID Venta</th>
                        <th>ID Pedido</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Monto</th>
                        <th>Método de Pago</th>
                        <th>Fecha de Pago</th>
                    </tr>
                </thead>
                <tbody id="table-all-sales">
                    <tr>
                        <td
                            colspan="7"
                            class="table-empty-row"
                        >
                            Cargando registro de ventas...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="pagination-controls">
            <button class="btn-action secondary btn-pagination" id="btn-sales-prev" disabled>
                <i data-lucide="chevron-left" class="icon-16"></i> Anterior
            </button>
            <span id="sales-page-info" class="pagination-info">Página 1</span>
            <button class="btn-action secondary btn-pagination" id="btn-sales-next" disabled>
                Siguiente <i data-lucide="chevron-right" class="icon-16"></i>
            </button>
        </div>
    </div>
</div>
