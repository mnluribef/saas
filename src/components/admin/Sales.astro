---
// src/components/admin/Sales.astro
---
<div id="section-sales" class="dashboard-section">
    <div class="content-card">
        <div class="card-header">
            <h2>
                Registro Histórico de Ventas{" "}
                <span
                    id="sales-total-amount"
                    style="font-size: 0.95rem; color: var(--success); margin-left: 1rem; font-weight: 500;"
                ></span>
            </h2>
            <div class="card-actions">
                <button
                    class="btn-action secondary"
                    id="btn-export-sales"
                    title="Exportar registro de ventas a archivo CSV / Excel"
                >
                    <i data-lucide="download"></i> Exportar CSV
                </button>
                <button
                    class="btn-action secondary"
                    id="btn-refresh-sales"
                >
                    <i data-lucide="refresh-cw"></i> Sincronizar
                </button>
            </div>
        </div>

        <!-- Barra de Búsqueda de Ventas -->
        <div style="padding: 0 1.5rem 1.25rem 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color);">
            <div style="flex: 1; min-width: 260px; max-width: 480px;">
                <input
                    type="text"
                    id="sales-search-input"
                    class="form-control"
                    placeholder="🔍 Buscar venta por cliente, método o #pedido..."
                    style="padding-left: 1rem; font-size: 0.9rem;"
                />
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <label for="sales-date-from" style="font-size: 0.85rem; color: var(--text-secondary);">Desde:</label>
                <input type="date" id="sales-date-from" class="form-control" style="width: auto; padding: 0.35rem; font-size: 0.85rem;" />
                
                <label for="sales-date-to" style="font-size: 0.85rem; color: var(--text-secondary); margin-left: 0.5rem;">Hasta:</label>
                <input type="date" id="sales-date-to" class="form-control" style="width: auto; padding: 0.35rem; font-size: 0.85rem;" />
                
                <button class="btn-action" id="btn-filter-sales-dates" style="padding: 0.45rem 0.8rem; font-size: 0.85rem; margin-left: 0.5rem;">
                    Filtrar
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID Venta</th>
                        <th>ID Pedido</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Monto</th>
                        <th>Método de Pago</th>
                        <th>Fecha de Pago</th>
                    </tr>
                </thead>
                <tbody id="table-all-sales">
                    <tr>
                        <td
                            colspan="7"
                            style="text-align: center; color: var(--text-secondary);"
                        >
                            Cargando registro de ventas...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="pagination-controls" style="display: flex; justify-content: center; gap: 1rem; padding: 1rem; border-top: 1px solid var(--border-color);">
            <button class="btn-action secondary" id="btn-sales-prev" disabled style="padding: 0.4rem 0.8rem;"><i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i> Anterior</button>
            <span id="sales-page-info" style="align-self: center; font-size: 0.85rem; color: var(--text-secondary); font-weight: 500;">Página 1</span>
            <button class="btn-action secondary" id="btn-sales-next" disabled style="padding: 0.4rem 0.8rem;">Siguiente <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i></button>
        </div>
    </div>
</div>
