---
// src/components/admin/Sidebar.astro
---
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="login-logo sidebar-logo">
            <i data-lucide="sparkles" class="sidebar-logo-icon"></i>
            <span class="logo-text">Vent<span class="sidebar-logo-accent">rina</span></span>
        </div>
    </div>
    <ul class="sidebar-menu">
        <li>
            <div class="sidebar-link active" data-target="section-metrics">
                <i data-lucide="layout-dashboard"></i>
                <span>Métricas Generales</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-orders">
                <i data-lucide="shopping-bag"></i>
                <span>Gestión Pedidos</span>
                <span id="sidebar-badge-orders" class="sidebar-badge-orders">0</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-sales">
                <i data-lucide="trending-up"></i>
                <span>Registro Ventas</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-inventory">
                <i data-lucide="package"></i>
                <span>Catálogo / Productos</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-coupons">
                <i data-lucide="ticket"></i>
                <span>Cupones Promocionales</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-billing">
                <i data-lucide="credit-card"></i>
                <span>Plan y Facturación</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-team">
                <i data-lucide="users"></i>
                <span>Mi Equipo</span>
            </div>
        </li>
        <li>
            <div class="sidebar-link" data-target="section-settings">
                <i data-lucide="settings"></i>
                <span>Configuración Tienda</span>
            </div>
        </li>
    </ul>
    <div class="sidebar-footer">
        <button class="btn-action secondary btn-change-password-full" id="btn-open-change-password">
            <i data-lucide="key"></i>
            <span>Cambiar Clave</span>
        </button>
        <div class="sidebar-link sidebar-link-logout" id="btn-logout">
            <i data-lucide="log-out"></i>
            <span>Cerrar Sesión</span>
        </div>
    </div>
</aside>
