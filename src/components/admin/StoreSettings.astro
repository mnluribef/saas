---
// src/components/admin/StoreSettings.astro
// Sección de Configuración Integral de la Tienda (Negocio, WhatsApp, Pagos, Textos y Delivery)
---
<div id="section-settings" class="dashboard-section">
    <div class="content-card">
        <div class="card-header">
            <div>
                <h2>Personalización y Configuración de Tienda</h2>
                <p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.25rem;">
                    Ajusta los datos del negocio, información de pago (Pago Móvil, Zelle), costos de delivery y apariencia de tu catálogo web.
                </p>
            </div>
            <div class="card-actions">
                <button class="btn-action secondary" id="btn-reload-settings">
                    <i data-lucide="refresh-cw"></i> Recargar
                </button>
            </div>
        </div>

        <form id="store-settings-form" style="padding: 1.5rem 0;">
            <!-- Pestañas o Bloques -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
                
                <!-- BLOQUE 1: Identidad y Negocio -->
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem;">
                    <h3 style="font-size: 1.05rem; color: var(--primary); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="store" style="width: 18px; height: 18px;"></i> Identidad del Negocio
                    </h3>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-business-name">Nombre de la Tienda</label>
                        <input type="text" id="cfg-business-name" class="form-control" placeholder="Ej: FOGÓN Gourmet" required />
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-tagline">Eslogan / Frase Clave</label>
                        <input type="text" id="cfg-tagline" class="form-control" placeholder="Ej: Sabor tradicional a la parrilla" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-description">Descripción Comercial</label>
                        <textarea id="cfg-description" class="form-control" rows="2" placeholder="Breve reseña que verán tus clientes..."></textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-group">
                            <label for="cfg-logo-primary">Logo Texto 1</label>
                            <input type="text" id="cfg-logo-primary" class="form-control" placeholder="Ej: FOG" />
                        </div>
                        <div class="form-group">
                            <label for="cfg-logo-secondary">Logo Texto 2</label>
                            <input type="text" id="cfg-logo-secondary" class="form-control" placeholder="Ej: ÓN" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 1rem;">
                        <label for="cfg-store-prefix">Prefijo de Pedidos (3-5 letras)</label>
                        <input type="text" id="cfg-store-prefix" class="form-control" maxlength="5" placeholder="Ej: FOG" style="text-transform: uppercase;" />
                        <span style="font-size: 0.75rem; color: var(--text-secondary);">Aparecerá en los números de orden: FOG-XXXX</span>
                    </div>
                </div>

                <!-- BLOQUE 2: Contacto y WhatsApp -->
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem;">
                    <h3 style="font-size: 1.05rem; color: #10B981; margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="message-circle" style="width: 18px; height: 18px;"></i> WhatsApp y Contacto
                    </h3>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-whatsapp">Número de WhatsApp (con código de país sin +)</label>
                        <input type="text" id="cfg-whatsapp" class="form-control" placeholder="Ej: 584124756191" required />
                        <span style="font-size: 0.75rem; color: var(--text-secondary);">Aquí llegarán los pedidos directamente.</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-whatsapp-display">WhatsApp Visible al Público</label>
                        <input type="text" id="cfg-whatsapp-display" class="form-control" placeholder="Ej: +58 412-4756191" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-email">Correo Electrónico</label>
                        <input type="email" id="cfg-email" class="form-control" placeholder="contacto@mitienda.com" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-address">Dirección Física del Local</label>
                        <input type="text" id="cfg-address" class="form-control" placeholder="Ej: Av. Principal, C.C. Las Américas" />
                    </div>

                    <div class="form-group">
                        <label for="cfg-hours">Horarios de Atención</label>
                        <input type="text" id="cfg-hours" class="form-control" placeholder="Ej: Lun – Dom: 11:00 AM – 10:00 PM" />
                    </div>
                </div>

                <!-- BLOQUE 3: Datos de Pago Móvil & Zelle -->
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem;">
                    <h3 style="font-size: 1.05rem; color: var(--accent); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="wallet" style="width: 18px; height: 18px;"></i> Métodos de Pago
                    </h3>

                    <h4 style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.8rem;">
                        📱 Datos Pago Móvil
                    </h4>

                    <div class="form-group" style="margin-bottom: 0.8rem;">
                        <label for="cfg-pm-banco">Banco y Código</label>
                        <input type="text" id="cfg-pm-banco" class="form-control" placeholder="Ej: Banesco (0134)" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.2rem;">
                        <div class="form-group">
                            <label for="cfg-pm-telefono">Teléfono</label>
                            <input type="text" id="cfg-pm-telefono" class="form-control" placeholder="Ej: 0412-4756191" />
                        </div>
                        <div class="form-group">
                            <label for="cfg-pm-cedula">Cédula / RIF</label>
                            <input type="text" id="cfg-pm-cedula" class="form-control" placeholder="Ej: V-12345678" />
                        </div>
                    </div>

                    <h4 style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.8rem;">
                        🇺🇸 Datos Zelle
                    </h4>

                    <div class="form-group" style="margin-bottom: 0.8rem;">
                        <label for="cfg-zelle-email">Correo Electrónico Zelle</label>
                        <input type="text" id="cfg-zelle-email" class="form-control" placeholder="Ej: pagos@mitienda.com" />
                    </div>

                    <div class="form-group">
                        <label for="cfg-zelle-titular">Nombre del Titular Zelle</label>
                        <input type="text" id="cfg-zelle-titular" class="form-control" placeholder="Ej: Nombre Empresa C.A." />
                    </div>
                </div>

                <!-- BLOQUE 4: Costos de Entrega y Textos del Carrito -->
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem;">
                    <h3 style="font-size: 1.05rem; color: #38BDF8; margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="truck" style="width: 18px; height: 18px;"></i> Delivery y Personalización
                    </h3>

                    <div style="display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label for="cfg-delivery-name">Nombre Opción Delivery</label>
                            <input type="text" id="cfg-delivery-name" class="form-control" placeholder="Ej: Delivery Express" />
                        </div>
                        <div class="form-group">
                            <label for="cfg-delivery-price">Costo Delivery ($)</label>
                            <input type="number" id="cfg-delivery-price" class="form-control" step="0.5" min="0" placeholder="5.00" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="cfg-pickup-name">Nombre Opción Retiro</label>
                        <input type="text" id="cfg-pickup-name" class="form-control" placeholder="Ej: Retiro en Local / Pick-up" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label for="cfg-item-noun-singular">Sustantivo Singular</label>
                            <input type="text" id="cfg-item-noun-singular" class="form-control" placeholder="Ej: Platillo, Prenda, Equipo" />
                        </div>
                        <div class="form-group">
                            <label for="cfg-item-noun-plural">Sustantivo Plural</label>
                            <input type="text" id="cfg-item-noun-plural" class="form-control" placeholder="Ej: Platillos, Prendas, Equipos" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="cfg-empty-cart-emoji">Emoji del Carrito</label>
                        <input type="text" id="cfg-empty-cart-emoji" class="form-control" placeholder="Ej: 🍽️ o 🛒 o 🛍️" maxlength="4" />
                    </div>
                </div>

            </div>

            <!-- Botón de Guardado Flotante o al Pie -->
            <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
                <button type="submit" class="btn-action" id="btn-save-settings" style="padding: 0.8rem 2.2rem; font-size: 1rem;">
                    <i data-lucide="save"></i> Guardar Todos los Cambios
                </button>
            </div>
        </form>
    </div>
</div>
