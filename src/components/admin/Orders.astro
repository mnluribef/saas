---
// src/components/admin/Orders.astro
---
<div id="section-orders" class="dashboard-section">
    <div class="content-card">
        <div class="card-header">
            <h2>
                Todos los Pedidos Recibidos{" "}
                <span
                    id="orders-total-summary"
                    class="header-accent-badge"
                ></span>
            </h2>
            <div class="card-actions">
                <button
                    class="btn-action secondary btn-compact"
                    id="btn-toggle-sound"
                    title="Alternar alertas de sonido para nuevos pedidos"
                >
                    <i data-lucide="volume-2" id="sound-icon"></i>
                </button>
                <button
                    class="btn-action secondary btn-compact btn-push-toggle"
                    id="btn-toggle-orders-push"
                    title="Alternar notificaciones de escritorio / Web Push"
                >
                    <i data-lucide="bell" id="orders-push-icon"></i>
                    <span class="push-dot d-none" id="orders-push-dot"></span>
                </button>
                <button
                    class="btn-action secondary"
                    id="btn-export-orders"
                    title="Exportar pedidos a archivo CSV / Excel"
                >
                    <i data-lucide="download"></i> Exportar CSV
                </button>
                <button
                    class="btn-action secondary"
                    id="btn-refresh-orders"
                >
                    <i data-lucide="refresh-cw"></i> Actualizar
                </button>
            </div>
        </div>

        <!-- Barra de Búsqueda y Filtros de Pedidos -->
        <div class="table-toolbar-border">
            <div class="table-search-box">
                <input
                    type="text"
                    id="orders-search-input"
                    class="form-control table-search-input-padded"
                    placeholder="🔍 Buscar por cliente, teléfono o #pedido..."
                />
            </div>
            <div class="table-filter-group">
                <label for="orders-date-filter" class="table-filter-label">
                    Filtrar por fecha:
                </label>
                <select id="orders-date-filter" class="form-control table-filter-select">
                    <option value="all">📅 Todas las fechas</option>
                    <option value="today">☀️ Hoy</option>
                    <option value="yesterday">⏪ Ayer</option>
                    <option value="last7">🗓️ Últimos 7 días</option>
                    <option value="this_month">📆 Este mes</option>
                </select>
            </div>
            <div class="table-filter-group">
                <label for="orders-status-filter" class="table-filter-label">
                    Filtrar por estado:
                </label>
                <select id="orders-status-filter" class="form-control table-filter-select">
                    <option value="">⚡ Todos los estados</option>
                    <option value="pendiente">🟡 Pendiente</option>
                    <option value="en_produccion">🔵 En Producción</option>
                    <option value="listo_entrega">🟢 Listo para Entrega</option>
                    <option value="completado">✅ Completado</option>
                    <option value="cancelado">❌ Cancelado</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID Pedido</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Artículos</th>
                        <th>Total</th>
                        <th>Fecha</th>
                        <th>Cambiar Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="table-all-orders">
                    <tr>
                        <td
                            colspan="8"
                            class="table-empty-row"
                        >
                            No hay pedidos registrados en el sistema.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="pagination-controls">
            <button class="btn-action secondary btn-pagination" id="btn-orders-prev" disabled>
                <i data-lucide="chevron-left" class="icon-16"></i> Anterior
            </button>
            <span id="orders-page-info" class="pagination-info">Página 1</span>
            <button class="btn-action secondary btn-pagination" id="btn-orders-next" disabled>
                Siguiente <i data-lucide="chevron-right" class="icon-16"></i>
            </button>
        </div>
    </div>
</div>
