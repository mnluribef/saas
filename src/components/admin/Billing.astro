---
// src/components/admin/Billing.astro
---
<div id="section-billing" class="dashboard-section">
    <div class="content-card">
        <div class="card-header">
            <div>
                <h2>Plan y Facturación</h2>
                <p class="section-desc">Gestiona los límites de tu cuenta y los pagos de tu suscripción SaaS.</p>
            </div>
            <button class="btn-action primary" id="btn-upgrade-plan">
                <i data-lucide="zap"></i> Mejorar Plan
            </button>
        </div>

        <div class="billing-stats-grid">
            <!-- Tarjeta de Plan Actual -->
            <div class="billing-card">
                <div class="billing-card-header">
                    <span class="stat-title">Tu Plan Actual</span>
                    <i data-lucide="award" class="billing-icon-primary"></i>
                </div>
                <div class="stat-value" id="billing-plan-name">Cargando...</div>
                <div class="stat-domain-badge" id="billing-tenant-domain">...</div>
                
                <div class="billing-status-row">
                    <span>Estado de Suscripción:</span>
                    <span id="billing-status" class="status-badge completado">Activo</span>
                </div>
            </div>

            <!-- Tarjeta de Consumo de Pedidos -->
            <div class="billing-card">
                <div class="billing-card-header">
                    <span class="stat-title">Pedidos este Mes</span>
                    <i data-lucide="shopping-cart" class="billing-icon-info"></i>
                </div>
                <div class="stat-value">
                    <span id="billing-orders-current">0</span> / <span id="billing-orders-limit" class="stat-limit">0</span>
                </div>
                
                <div class="progress-track">
                    <div id="billing-orders-bar" class="progress-bar progress-info"></div>
                </div>
                <div class="progress-percent" id="billing-orders-percent">0% utilizado</div>
            </div>

            <!-- Tarjeta de Consumo de Productos -->
            <div class="billing-card">
                <div class="billing-card-header">
                    <span class="stat-title">Productos en Catálogo</span>
                    <i data-lucide="package" class="billing-icon-warning"></i>
                </div>
                <div class="stat-value">
                    <span id="billing-products-current">0</span> / <span id="billing-products-limit" class="stat-limit">0</span>
                </div>
                
                <div class="progress-track">
                    <div id="billing-products-bar" class="progress-bar progress-warning"></div>
                </div>
                <div class="progress-percent" id="billing-products-percent">0% utilizado</div>
            </div>
        </div>

        <!-- Información de Pago (Manual) -->
        <div class="billing-payment-section">
            <div class="billing-section-title">
                <h3>Información para Pagos de Mensualidad</h3>
                <p>Realiza el pago manual de tu suscripción para mantener el servicio activo. Envía el comprobante por WhatsApp.</p>
            </div>
            
            <div class="billing-methods-grid">
                <div class="billing-card">
                    <h4 class="billing-method-title">
                        <i data-lucide="landmark" class="billing-icon-success"></i> Pago Móvil
                    </h4>
                    <div class="billing-info-list">
                        <div>Banco: <strong id="pay-bank">Banesco (0134)</strong></div>
                        <div>Teléfono: <strong id="pay-phone">0414-1234567</strong></div>
                        <div>RIF/Cédula: <strong id="pay-id">J-12345678-9</strong></div>
                    </div>
                </div>

                <div class="billing-card">
                    <h4 class="billing-method-title">
                        <i data-lucide="wallet" class="billing-icon-warning"></i> Cripto / Internacional
                    </h4>
                    <div class="billing-info-list">
                        <div>Binance Pay: <strong id="pay-binance">pagos@vendly.app</strong></div>
                        <div>Zelle: <strong id="pay-zelle">pagos@vendly.app</strong></div>
                    </div>
                </div>
                
                <div class="billing-card billing-card-highlight">
                    <h4 class="billing-method-title">
                        Mensualidad
                    </h4>
                    <div class="billing-price-box">
                        $<span id="pay-amount">15</span> <span class="billing-price-period">/ mes</span>
                    </div>
                    <p class="billing-price-note">Renovación automática los días 1 de cada mes.</p>
                    <button class="btn-action primary btn-full-width" id="btn-report-payment">
                        <i data-lucide="send"></i> Reportar Pago
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
