---
// src/components/admin/Inventory.astro
---
<div id="section-inventory" class="dashboard-section">
    <div class="content-card">
        <div class="card-header">
            <div>
                <h2>Gestión de Catálogo Multinegocio</h2>
                <p class="section-desc">
                    Catálogo separado por plantilla: Restaurante, Ferretería, Moda y Tecnología
                </p>
            </div>
            <div class="card-actions">
                <button
                    class="btn-action"
                    id="btn-toggle-product-form"
                >
                    <i data-lucide="plus"></i> Nuevo Producto
                </button>
                <button
                    class="btn-action secondary"
                    id="btn-refresh-products"
                >
                    <i data-lucide="refresh-cw"></i> Actualizar
                </button>
            </div>
        </div>
        <!-- Formulario Añadir/Editar Producto (colapsable) -->
        <div
            id="product-form-collapse"
            class="collapsible-content form-collapsible-padded"
        >
            <div class="form-collapsible-inner">
                <h3
                    id="form-product-title"
                    class="form-collapsible-title"
                >
                    Añadir Nuevo Producto
                </h3>
                <form id="product-form">
                    <input
                        type="hidden"
                        id="prod-method"
                        value="POST"
                    />

                    <div class="form-grid-auto">
                        <div class="form-group">
                            <label for="prod-template">
                                Plantilla / Tipo de Negocio
                            </label>
                            <select
                                id="prod-template"
                                class="form-control"
                            >
                                <option value="restaurant">🍽️ Restaurante (Gastronomía)</option>
                                <option value="hardware">🔨 Ferretería (Herramientas/Construcción)</option>
                                <option value="autoparts">🚗 Repuestos (Autopartes)</option>
                                <option value="fashion">👗 Moda & Ropa (Boutique/Calzado)</option>
                                <option value="tech">⚡ Tecnología (Gaming/PC/Equipos)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="prod-id">
                                Slug / ID Único
                            </label>
                            <input
                                type="text"
                                id="prod-id"
                                class="form-control"
                                placeholder="ej: taladro-percutor-12v"
                                required
                            />
                            <span class="field-hint">
                                Minúsculas, números o guiones.
                            </span>
                        </div>
                        <div class="form-group">
                            <label for="prod-name">
                                Nombre del Producto
                            </label>
                            <input
                                type="text"
                                id="prod-name"
                                class="form-control"
                                placeholder="ej: Taladro Percutor 12V"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <label for="prod-category">
                                Categoría
                            </label>
                            <select
                                id="prod-category"
                                class="form-control"
                            >
                                <optgroup label="🍽️ Restaurante">
                                    <option value="entradas">🥗 Entradas</option>
                                    <option value="principales">🍔 Principales & Hamburguesas</option>
                                    <option value="bebidas">🥤 Bebidas & Cócteles</option>
                                    <option value="postres">🍰 Postres & Dulces</option>
                                    <option value="promociones">🔥 Promociones</option>
                                </optgroup>
                                <optgroup label="🔨 Ferretería">
                                    <option value="herramientas-manuales">🛠️ Herramientas Manuales</option>
                                    <option value="herramientas-electricas">⚡ Herramientas Eléctricas</option>
                                    <option value="seguridad">🦺 Seguridad Industrial</option>
                                    <option value="electricidad">💡 Electricidad</option>
                                    <option value="construccion-pinturas">🎨 Construcción & Pinturas</option>
                                </optgroup>
                                <optgroup label="👗 Moda">
                                    <option value="vestidos">👗 Vestidos & Enterizos</option>
                                    <option value="blusas-tops">👚 Blusas & Tops</option>
                                    <option value="pantalones-jeans">👖 Pantalones & Jeans</option>
                                    <option value="conjuntos">🧥 Conjuntos & Sets</option>
                                    <option value="accesorios-calzado">👜 Calzado & Accesorios</option>
                                </optgroup>
                                <optgroup label="⚡ Tecnología">
                                    <option value="laptops-pc">💻 Laptops & PC</option>
                                    <option value="componentes">💾 Componentes & Almacenamiento</option>
                                    <option value="perifericos">🎧 Periféricos & Audio</option>
                                    <option value="smartphones-tablets">📱 Smartphones & Tablets</option>
                                    <option value="accesorios-redes">📡 Redes & Conectividad</option>
                                </optgroup>
                                <optgroup label="🚗 Repuestos">
                                    <option value="frenos">🛑 Frenos & Discos</option>
                                    <option value="motor-partes">⚙️ Motor & Partes</option>
                                    <option value="suspension-direccion">🛞 Suspensión & Dirección</option>
                                    <option value="baterias-electricidad">🔋 Baterías & Encendido</option>
                                    <option value="accesorios-repuestos">🧰 Filtros & Accesorios</option>
                                </optgroup>
                            </select>
                        </div>
                    </div>

                    <div class="form-grid-220">
                        <div class="form-group">
                            <label for="prod-brand">Marca (Opcional)</label>
                            <input type="text" id="prod-brand" class="form-control" placeholder="ej: Bosch, Makita..." />
                        </div>
                        <div class="form-group">
                            <label for="prod-model">Modelo (Opcional)</label>
                            <input type="text" id="prod-model" class="form-control" placeholder="ej: GSB 12V-30" />
                        </div>
                    </div>

                    <div class="form-grid-220">
                        <div class="form-group">
                            <label for="prod-price">
                                Precio en USD ($)
                            </label>
                            <input
                                type="number"
                                id="prod-price"
                                class="form-control"
                                step="0.01"
                                min="0"
                                placeholder="0.00"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <label for="prod-icon">
                                Icono (Lucide)
                            </label>
                            <input
                                type="text"
                                id="prod-icon"
                                class="form-control"
                                placeholder="ej: utensils, salad, cake, cup-soda"
                            />
                        </div>
                        <div class="form-group">
                            <label for="prod-image">
                                Imagen del Producto
                            </label>
                            <div class="product-image-uploader">
                                <input
                                    type="text"
                                    id="prod-image"
                                    class="form-control"
                                    placeholder="https://images.unsplash.com/... o subir archivo"
                                />
                                <button type="button" class="btn-action secondary btn-upload-trigger" id="btn-upload-prod-image" title="Subir imagen desde tu dispositivo">
                                    <i data-lucide="upload"></i>
                                </button>
                                <input type="file" id="prod-image-file" class="file-input-hidden" accept="image/*" />
                                <div id="prod-image-preview" class="prod-image-preview-thumb"></div>
                            </div>
                            <span class="field-hint">
                                Pega un enlace directo o sube una foto desde tu dispositivo (Cloudflare R2).
                            </span>
                        </div>
                    </div>

                    <div class="form-grid-220">
                        <div class="form-group">
                            <label for="prod-sizes">
                                Opciones Rápidas (Separadas por comas)
                            </label>
                            <input
                                type="text"
                                id="prod-sizes"
                                class="form-control"
                                placeholder="ej: Res, Pollo, Mixto (o dejar vacío)"
                            />
                        </div>
                        <div class="form-group">
                            <label for="prod-stock">
                                Stock / Inventario Disponible
                            </label>
                            <input
                                type="number"
                                id="prod-stock"
                                class="form-control"
                                placeholder="-1 para ilimitado, o >= 0"
                                value="-1"
                                min="-1"
                            />
                            <span class="field-hint">
                                -1 = Stock infinito. O define las unidades reales en existencia.
                            </span>
                        </div>
                        <div class="form-group">
                            <label for="prod-active">
                                Disponibilidad en Menú
                            </label>
                            <select
                                id="prod-active"
                                class="form-control"
                            >
                                <option value="1">
                                    Disponible (Activo)
                                </option>
                                <option value="0">
                                    Agotado / Pausado (Oculto)
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="prod-description">
                            Descripción
                        </label>
                        <textarea
                            id="prod-description"
                            class="form-control"
                            rows="2"
                            placeholder="Describe las características, especificaciones y detalles del producto..."
                        ></textarea>
                    </div>

                    <div class="form-actions-end">
                        <button
                            type="button"
                            class="btn-action secondary d-none"
                            id="btn-cancel-edit"
                        >
                            Cancelar Edición
                        </button>
                        <button
                            type="submit"
                            class="btn-action"
                            id="btn-submit-product"
                        >
                            <i data-lucide="plus-circle"></i>{" "}
                            Guardar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Barra de Filtros por Plantilla -->
        <div class="filter-tabs" id="template-filter-tabs">
            <span class="filter-badge-label">
                <i data-lucide="filter" class="icon-14"></i> Filtrar por Plantilla:
            </span>
            <button type="button" class="filter-tab-btn active" data-filter="all">
                📦 Todas (<span id="count-all">0</span>)
            </button>
            <button type="button" class="filter-tab-btn" data-filter="restaurant">
                🍽️ Restaurante (<span id="count-restaurant">0</span>)
            </button>
            <button type="button" class="filter-tab-btn" data-filter="hardware">
                🔨 Ferretería (<span id="count-hardware">0</span>)
            </button>
            <button type="button" class="filter-tab-btn" data-filter="autoparts">
                🚗 Repuestos (<span id="count-autoparts">0</span>)
            </button>
            <button type="button" class="filter-tab-btn" data-filter="fashion">
                👗 Moda (<span id="count-fashion">0</span>)
            </button>
            <button type="button" class="filter-tab-btn" data-filter="tech">
                ⚡ Tecnología (<span id="count-tech">0</span>)
            </button>
        </div>

        <!-- Barra de Búsqueda de Productos -->
        <div class="table-toolbar">
            <div class="table-search-box">
                <input
                    type="text"
                    id="products-search-input"
                    class="form-control"
                    placeholder="🔍 Buscar producto por nombre o slug..."
                />
            </div>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Slug</th>
                        <th>Nombre</th>
                        <th>Plantilla</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Opciones</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="table-products">
                    <tr>
                        <td colspan="10" class="table-empty-row">
                            Cargando productos...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="pagination-controls">
            <button class="btn-action secondary btn-pagination" id="btn-products-prev" disabled>
                <i data-lucide="chevron-left" class="icon-16"></i> Anterior
            </button>
            <span id="products-page-info" class="pagination-info">Página 1</span>
            <button class="btn-action secondary btn-pagination" id="btn-products-next" disabled>
                Siguiente <i data-lucide="chevron-right" class="icon-16"></i>
            </button>
        </div>
    </div>
</div>
