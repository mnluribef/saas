---
// src/components/admin/Header.astro
---
<header class="main-header">
    <div class="header-actions">
        <!-- Grupo Izquierdo: Accesos rápidos de la tienda + Toggle Móvil -->
        <div class="header-actions-group header-actions-left">
            <button
                type="button"
                class="btn-sidebar-toggle"
                id="btn-sidebar-toggle"
                title="Abrir menú"
                aria-label="Abrir menú"
            >
                <i data-lucide="menu" class="icon-16"></i>
            </button>

            <a
                href="/demo/restaurant"
                target="_blank"
                rel="noopener"
                class="btn-header-store"
                id="btn-header-view-store"
                title="Abrir tienda pública en una nueva pestaña"
                aria-label="Ver tienda pública"
            >
                <i data-lucide="external-link" class="icon-16"></i>
                <span class="btn-header-store-text">Ver Tienda</span>
            </a>

            <button
                type="button"
                class="btn-header-qr"
                id="btn-header-qr"
                title="Ver y descargar código QR de la tienda"
                aria-label="Código QR de la tienda"
            >
                <i data-lucide="qr-code" class="icon-16"></i>
                <span class="btn-header-qr-text">Código QR</span>
            </button>
        </div>

        <!-- Grupo Derecho: Estado del Sistema, Tasa BCV & Perfil Admin -->
        <div class="header-actions-group header-actions-right">
            <div class="badge-bcv-wrapper">
                <div class="badge-bcv-info">
                    <span class="badge-bcv-label">BCV:</span>
                    <span class="badge-bcv-val" id="admin-bcv-val">-- Bs.</span>
                </div>
                <button
                    type="button"
                    class="btn-icon-square"
                    id="btn-open-bcv-modal"
                    title="Configurar Tasa BCV"
                    aria-label="Configurar Tasa BCV"
                >
                    <i data-lucide="settings-2" class="icon-14"></i>
                </button>
            </div>

            <button
                type="button"
                class="btn-icon-square btn-push-toggle"
                id="btn-toggle-push"
                title="Activar notificaciones de escritorio / Web Push para nuevos pedidos"
                aria-label="Notificaciones Web Push"
            >
                <i data-lucide="bell" id="header-push-icon" class="icon-16"></i>
                <span class="push-dot d-none" id="push-status-dot"></span>
            </button>

            <div id="connection-status" class="status-indicator online">
                <div class="status-dot"></div>
                <span id="connection-status-text" class="status-text">En línea</span>
            </div>

            <div class="user-badge d-none" id="user-info-badge">
                <div class="user-avatar">
                    <i data-lucide="shield" class="icon-14"></i>
                </div>
                <div class="user-details">
                    <span class="user-role">Administrador</span>
                    <span class="user-name" id="admin-user-name">...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="main-title">
        <h1 id="dashboard-title">Métricas Generales</h1>
        <p id="dashboard-subtitle">Visión global de rendimiento, pedidos y catálogo.</p>
    </div>
</header>
