---
// src/components/admin/Header.astro
---
<header class="main-header">
    <div class="main-title">
        <h1 id="dashboard-title">Métricas Generales</h1>
        <p id="dashboard-subtitle">Visión global de rendimiento, pedidos y catálogo en FOGÓN.</p>
    </div>
    
    <div style="display: flex; align-items: center; gap: 1.5rem;">
        <div class="badge-bcv" style="display: flex; align-items: center; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 12px; gap: 0.8rem;">
            <div style="display: flex; flex-direction: column; align-items: flex-end;">
                <span style="font-size: 0.7rem; color: var(--text-secondary); font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">Tasa BCV Activa</span>
                <span style="font-weight: 800; color: var(--primary);" id="admin-bcv-val">-- Bs.</span>
            </div>
            <button class="btn-action secondary" id="btn-open-bcv-modal" title="Configurar Tasa BCV" style="padding: 0.4rem; border-radius: 8px;">
                <i data-lucide="settings-2" style="width: 18px; height: 18px;"></i>
            </button>
        </div>

        <div id="connection-status" class="status-indicator online" style="display: flex; align-items: center; gap: 0.5rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); padding: 0.4rem 0.8rem; border-radius: 12px; transition: all 0.3s;">
            <div class="status-dot" style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 8px var(--success);"></div>
            <span id="connection-status-text" style="font-size: 0.75rem; color: var(--success); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">En línea</span>
        </div>

        <div class="user-badge" id="user-info-badge" style="display: flex; align-items: center; gap: 0.8rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 0.4rem 1rem 0.4rem 0.4rem; border-radius: 50px; display: none;">
            <div class="user-avatar" style="width: 36px; height: 36px; background: var(--primary); color: var(--dark-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i data-lucide="shield" style="width: 18px; height: 18px;"></i>
            </div>
            <div class="user-details" style="display: flex; flex-direction: column;">
                <span class="user-role" style="font-size: 0.7rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Administrador</span>
                <span class="user-name" id="admin-user-name" style="font-size: 0.9rem; font-weight: 600; color: var(--white);">...</span>
            </div>
        </div>
    </div>
</header>
