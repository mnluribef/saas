---
// src/components/admin/Header.astro
---
<header class="main-header">
    <div class="header-left">
        <button class="btn-action secondary btn-sidebar-toggle" id="btn-sidebar-toggle" title="Abrir menú" aria-label="Abrir menú">
            <i data-lucide="menu"></i>
        </button>
        <div class="main-title">
            <h1 id="dashboard-title">Métricas Generales</h1>
            <p id="dashboard-subtitle">Visión global de rendimiento, pedidos y catálogo.</p>
        </div>
    </div>
    
    <div class="header-actions">
        <div class="badge-bcv-wrapper">
            <div class="badge-bcv-info">
                <span class="badge-bcv-label">Tasa BCV Activa</span>
                <span class="badge-bcv-val" id="admin-bcv-val">-- Bs.</span>
            </div>
            <button class="btn-action secondary btn-icon-square" id="btn-open-bcv-modal" title="Configurar Tasa BCV">
                <i data-lucide="settings-2" class="icon-18"></i>
            </button>
        </div>

        <div id="connection-status" class="status-indicator online">
            <div class="status-dot"></div>
            <span id="connection-status-text" class="status-text">En línea</span>
        </div>

        <div class="user-badge d-none" id="user-info-badge">
            <div class="user-avatar">
                <i data-lucide="shield" class="icon-18"></i>
            </div>
            <div class="user-details">
                <span class="user-role">Administrador</span>
                <span class="user-name" id="admin-user-name">...</span>
            </div>
        </div>
    </div>
</header>
