---
// src/components/common/TemplateSwitcher.astro
// Selector flotante para previsualizar las diferentes plantillas de Ventrina SaaS
import type { StoreTemplateType } from '../../types/store.types';
import '../../styles/template-switcher.css';

export interface Props {
  activeTemplate: StoreTemplateType;
}

const { activeTemplate } = Astro.props;

const templates = [
  { id: 'restaurant', name: 'Restaurante', icon: '🍽️', url: '/demo/restaurant', brand: 'FOGÓN' },
  { id: 'hardware', name: 'Ferretería', icon: '🔨', url: '/demo/hardware', brand: 'FERROMAX' },
  { id: 'fashion', name: 'Moda & Ropa', icon: '👗', url: '/demo/fashion', brand: 'AURA' },
  { id: 'tech', name: 'Tecnología', icon: '⚡', url: '/demo/tech', brand: 'NEXUS' },
  { id: 'autoparts', name: 'Repuestos', icon: '🚗', url: '/demo/autoparts', brand: 'MOTOPARTS' },
  { id: 'grocery', name: 'Bodegón', icon: '🛒', url: '/demo/grocery', brand: 'BODEGÓN' },
];
---

<div class="ventrina-template-bar template-switcher" id="ventrina-template-bar">
  <div class="template-bar-inner">
    <a href="/" class="template-bar-brand">
      <span class="pulse-dot"></span>
      <span class="brand-title">Ventrina SaaS</span>
    </a>

    <div class="template-bar-pills">
      {templates.map((t) => {
        const isActive = activeTemplate === t.id;
        return (
          <a
            href={t.url}
            class={`template-pill ${isActive ? 'active' : ''}`}
            title={`Ver plantilla de ${t.name} (${t.brand})`}
          >
            <span class="pill-icon">{t.icon}</span>
            <span class="pill-text">{t.name}</span>
            {isActive && <span class="pill-active-indicator">Activo</span>}
          </a>
        );
      })}
    </div>
  </div>
</div>
