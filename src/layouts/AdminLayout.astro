---
// src/layouts/AdminLayout.astro
import Sidebar from '../components/admin/Sidebar.astro';
import Header from '../components/admin/Header.astro';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Vendly | Panel Administrativo</title>
        <meta name="robots" content="noindex, nofollow" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />

        <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest" is:inline></script>
        
        <!-- Chart.js -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
        
        <!-- Admin Settings Stylesheet -->
        <link rel="stylesheet" href="/admin-settings.css" />
        
        <style is:inline>
            :root {
                --primary: #c9748a;
                --accent: #b8860b;
                --yellow: #d4af37;
                --dark-bg: #0f0b0d;
                --card-bg: rgba(35, 22, 28, 0.75);
                --border-color: rgba(255, 255, 255, 0.08);
                --text-primary: #fdf8f5;
                --text-secondary: #c4a8b0;
                --white: #ffffff;
                --success: #22c55e;
                --warning: #eab308;
                --danger: #ef4444;
                --info: #3b82f6;
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                font-family: "Inter", sans-serif;
                background-color: var(--dark-bg);
                color: var(--text-primary);
                line-height: 1.6;
                min-height: 100vh;
                overflow-x: hidden;
                background-image:
                    radial-gradient(
                        at 0% 0%,
                        var(--primary-light, rgba(99, 102, 241, 0.12)) 0px,
                        transparent 50%
                    ),
                    radial-gradient(
                        at 100% 100%,
                        var(--accent-light, rgba(6, 182, 212, 0.12)) 0px,
                        transparent 50%
                    );
                background-attachment: fixed;
            }

            /* Loading overlay */
            .page-loader {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: var(--dark-bg);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
                transition: opacity 0.5s;
            }

            /* Dashboard Layout */
            .dashboard-container {
                display: flex;
                min-height: 100vh;
            }
            .sidebar {
                width: 280px;
                background: rgba(15, 22, 42, 0.85);
                backdrop-filter: blur(12px);
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                z-index: 100;
                transition: var(--transition);
            }
            .sidebar-header {
                padding: 2rem 1.5rem;
                border-bottom: 1px solid var(--border-color);
            }
            .sidebar-menu {
                list-style: none;
                padding: 2rem 1rem;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                flex: 1;
            }
            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 0.8rem;
                padding: 0.9rem 1.2rem;
                color: var(--text-secondary);
                border-radius: 12px;
                font-weight: 500;
                font-size: 0.95rem;
                cursor: pointer;
                transition: var(--transition);
            }
            .sidebar-link:hover,
            .sidebar-link.active {
                color: var(--white);
                background: rgba(255, 255, 255, 0.05);
            }
            .sidebar-link.active {
                background: linear-gradient(
                    135deg,
                    rgba(0, 194, 255, 0.15) 0%,
                    rgba(255, 20, 147, 0.05) 100%
                );
                border-left: 3px solid var(--primary);
                color: var(--primary);
            }
            .sidebar-footer {
                padding: 1.5rem;
                border-top: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }
            .main-content {
                margin-left: 280px;
                flex: 1;
                padding: 2.5rem;
                min-width: 0;
                overflow-x: hidden;
                transition: var(--transition);
            }
            .main-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 2.5rem;
            }
            .main-title h1 {
                font-size: 2rem;
                font-family: "Outfit", sans-serif;
                color: var(--white);
                margin-bottom: 0.25rem;
            }
            .main-title p {
                color: var(--text-secondary);
                font-size: 0.95rem;
            }
            .metrics-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 1.5rem;
                margin-bottom: 2.5rem;
            }
            .metric-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
                transition: var(--transition);
            }
            .metric-card:hover {
                transform: translateY(-3px);
                border-color: rgba(255, 255, 255, 0.15);
            }
            .metric-info h3 {
                font-size: 0.85rem;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.05em;
                margin-bottom: 0.5rem;
                font-weight: 600;
            }
            .metric-info p {
                font-size: 1.8rem;
                font-family: "Outfit", sans-serif;
                font-weight: 700;
                color: var(--white);
            }
            .metric-icon {
                width: 54px;
                height: 54px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .metric-icon.blue {
                background: rgba(0, 194, 255, 0.15);
                color: var(--primary);
            }
            .metric-icon.pink {
                background: rgba(255, 20, 147, 0.15);
                color: var(--accent);
            }
            .metric-icon.yellow {
                background: rgba(255, 215, 0, 0.15);
                color: var(--yellow);
            }
            .metric-icon.green {
                background: rgba(34, 197, 94, 0.15);
                color: var(--success);
            }
            .dashboard-section {
                display: none;
                animation: fadeIn 0.4s ease-out forwards;
            }
            .dashboard-section.active {
                display: block;
            }
            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .content-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 24px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
                margin-bottom: 2rem;
                overflow: hidden;
            }
            .card-header {
                padding: 1.5rem 2rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .card-header h2 {
                font-size: 1.25rem;
                font-family: "Outfit", sans-serif;
                font-weight: 600;
                color: var(--white);
            }
            .card-actions {
                display: flex;
                gap: 0.75rem;
            }
            .btn-action {
                background: var(--accent);
                color: var(--white);
                border: none;
                border-radius: 10px;
                padding: 0.6rem 1.2rem;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                gap: 0.4rem;
                text-decoration: none;
            }
            .btn-action:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(255, 20, 147, 0.3);
            }
            .btn-action.secondary {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
            }
            .btn-action.secondary:hover {
                background: rgba(255, 255, 255, 0.1);
                box-shadow: none;
            }
            .table-responsive {
                overflow-x: auto;
                width: 100%;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                font-size: 0.9rem;
            }
            th {
                background: rgba(15, 22, 42, 0.4);
                padding: 1.2rem 1.5rem;
                color: var(--text-secondary);
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
                border-bottom: 1px solid var(--border-color);
            }
            td {
                padding: 1.2rem 1.5rem;
                border-bottom: 1px solid var(--border-color);
                color: var(--text-primary);
            }
            tr:last-child td {
                border-bottom: none;
            }
            tr:hover td {
                background: rgba(255, 255, 255, 0.01);
            }
            .status-badge {
                display: inline-flex;
                align-items: center;
                padding: 0.3rem 0.75rem;
                border-radius: 50px;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                gap: 0.3rem;
            }
            .status-badge.pendiente {
                background: rgba(234, 179, 8, 0.15);
                color: var(--warning);
            }
            .status-badge.en_produccion {
                background: rgba(59, 130, 246, 0.15);
                color: var(--info);
            }
            .status-badge.listo_entrega {
                background: rgba(0, 194, 255, 0.15);
                color: var(--primary);
            }
            .status-badge.completado {
                background: rgba(34, 197, 94, 0.15);
                color: var(--success);
            }
            .status-badge.cancelado {
                background: rgba(239, 68, 68, 0.15);
                color: var(--danger);
            }
            .filter-tabs {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
                padding: 1rem 1.5rem;
                background: rgba(255, 255, 255, 0.02);
                border-bottom: 1px solid var(--border-color);
            }
            .filter-tab-btn {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
                border-radius: 8px;
                padding: 0.45rem 0.9rem;
                font-size: 0.82rem;
                font-weight: 500;
                cursor: pointer;
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }
            .filter-tab-btn:hover {
                background: rgba(255, 255, 255, 0.1);
                color: var(--white);
            }
            .filter-tab-btn.active {
                background: var(--primary);
                border-color: var(--primary);
                color: #070913;
                font-weight: 600;
            }
            .template-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.25rem 0.6rem;
                border-radius: 6px;
                font-size: 0.75rem;
                font-weight: 600;
                white-space: nowrap;
            }
            .template-badge.restaurant {
                background: rgba(255, 149, 0, 0.15);
                color: #ffaa33;
                border: 1px solid rgba(255, 149, 0, 0.3);
            }
            .template-badge.hardware {
                background: rgba(245, 158, 11, 0.15);
                color: #fbbf24;
                border: 1px solid rgba(245, 158, 11, 0.3);
            }
            .template-badge.autoparts {
                background: rgba(220, 38, 38, 0.15);
                color: #ef4444;
                border: 1px solid rgba(220, 38, 38, 0.3);
            }
            .template-badge.fashion {
                background: rgba(236, 72, 153, 0.15);
                color: #f472b6;
                border: 1px solid rgba(236, 72, 153, 0.3);
            }
            .template-badge.tech {
                background: rgba(6, 182, 212, 0.15);
                color: #22d3ee;
                border: 1px solid rgba(6, 182, 212, 0.3);
            }
            .status-select {
                background: rgba(15, 22, 42, 0.9);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                padding: 0.4rem 0.6rem;
                border-radius: 8px;
                outline: none;
                font-size: 0.85rem;
                cursor: pointer;
                transition: var(--transition);
            }
            .status-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 8px rgba(0, 194, 255, 0.2);
            }
            .status-select option,
            .form-control option,
            select option {
                background-color: #0b0f19;
                color: var(--text-primary);
            }
            .form-group {
                margin-bottom: 1rem;
            }
            .form-group label {
                display: block;
                font-size: 0.85rem;
                color: var(--text-secondary);
                margin-bottom: 0.4rem;
                font-weight: 500;
            }
            .form-control {
                width: 100%;
                background: rgba(15, 22, 42, 0.6);
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 0.65rem 0.9rem;
                color: var(--text-primary);
                font-size: 0.9rem;
                outline: none;
                transition: var(--transition);
                font-family: inherit;
            }
            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 10px rgba(0, 194, 255, 0.15);
            }
            .action-icon-btn {
                background: none;
                border: none;
                cursor: pointer;
                color: var(--text-secondary);
                padding: 0.3rem;
                border-radius: 6px;
                transition: var(--transition);
            }
            .action-icon-btn:hover {
                color: var(--white);
                background: rgba(255, 255, 255, 0.05);
            }
            .action-icon-btn.delete:hover {
                color: var(--danger);
                background: rgba(239, 68, 68, 0.1);
            }
            .action-icon-btn.edit:hover {
                color: var(--primary);
                background: rgba(0, 194, 255, 0.1);
            }

            /* Modales */
            .modal {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(11, 15, 25, 0.7);
                backdrop-filter: blur(8px);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 1000;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s;
            }
            .modal.active {
                opacity: 1;
                pointer-events: auto;
            }
            .modal-content {
                background: rgba(22, 29, 49, 0.95);
                backdrop-filter: blur(16px);
                border: 1px solid var(--border-color);
                border-radius: 28px;
                padding: 2.5rem;
                width: 100%;
                max-width: 600px;
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
                transform: translateY(20px);
                transition: transform 0.3s;
            }
            .modal.active .modal-content {
                transform: translateY(0);
            }
            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
            }
            .modal-header h3 {
                font-size: 1.4rem;
                font-family: "Outfit", sans-serif;
                color: var(--white);
            }
            .modal-close {
                background: none;
                border: none;
                color: var(--text-secondary);
                cursor: pointer;
                padding: 0.2rem;
                border-radius: 50%;
                transition: var(--transition);
            }
            .modal-close:hover {
                color: var(--white);
                background: rgba(255, 255, 255, 0.05);
            }
            .modal-body {
                max-height: 420px;
                overflow-y: auto;
                margin-bottom: 1.5rem;
                padding-right: 0.5rem;
            }
            .modal-footer {
                display: flex;
                justify-content: flex-end;
                gap: 1rem;
            }

            .order-meta-info {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1.2rem;
                background: rgba(15, 22, 42, 0.4);
                padding: 1.2rem;
                border-radius: 16px;
                margin-bottom: 1.5rem;
            }
            .order-meta-info p {
                font-size: 0.85rem;
                color: var(--text-secondary);
            }
            .order-meta-info p strong,
            .order-meta-info > div > strong {
                color: var(--white);
                display: block;
                font-size: 0.95rem;
                margin-top: 0.2rem;
            }

            .detail-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0.9rem 0;
                border-bottom: 1px solid var(--border-color);
            }
            .detail-item:last-child {
                border-bottom: none;
            }
            .detail-item-info {
                display: flex;
                align-items: center;
                gap: 0.8rem;
            }
            .detail-item-icon {
                width: 38px;
                height: 38px;
                background: rgba(255, 20, 147, 0.1);
                color: var(--accent);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .detail-item-name h4 {
                font-size: 0.95rem;
                color: var(--white);
                font-weight: 500;
            }
            .detail-item-name span {
                font-size: 0.8rem;
                color: var(--text-secondary);
            }
            .detail-item-qty {
                font-family: "Outfit", sans-serif;
                font-weight: 600;
                color: var(--primary);
                font-size: 1.05rem;
            }

            /* Collapsible */
            .collapsible-content {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s ease-out;
            }
            .collapsible-content.expanded {
                max-height: 2000px;
            }

            .toast-container {
                position: fixed;
                bottom: 30px;
                right: 30px;
                z-index: 2000;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
            }
            .toast {
                background: rgba(22, 29, 49, 0.9);
                backdrop-filter: blur(8px);
                border: 1px solid var(--border-color);
                border-left: 4px solid var(--primary);
                border-radius: 12px;
                padding: 1rem 1.5rem;
                min-width: 280px;
                color: var(--text-primary);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
                display: flex;
                align-items: center;
                gap: 0.8rem;
                font-size: 0.9rem;
                animation: slideIn 0.3s ease-out forwards;
            }
            .toast.success {
                border-left-color: var(--success);
            }
            .toast.error {
                border-left-color: var(--danger);
            }

            /* --- MODO IMPRESIÓN (PRINT) --- */
            @media print {
                @page { margin: 0; }
                body * {
                    visibility: hidden;
                }
                .modal.active .modal-content,
                .modal.active .modal-content * {
                    visibility: visible;
                }
                .modal.active .modal-content {
                    position: absolute;
                    left: 0;
                    top: 0;
                    margin: 0;
                    padding: 0;
                    width: 100%;
                    box-shadow: none;
                    background: white;
                    color: black;
                }
                .modal-header h3 {
                    color: black;
                }
                .modal-close,
                .modal-footer {
                    display: none !important;
                }
                .order-meta-info {
                    background: white;
                    border: 1px solid #ccc;
                    border-radius: 0;
                }
                .order-meta-info p strong, .order-meta-info > div > strong,
                .detail-item-name h4, .detail-item-name span, .detail-item-qty,
                .order-meta-info p {
                    color: black !important;
                }
                .detail-item {
                    border-bottom: 1px solid #ddd;
                }
            }
        </style>
    </head>
    <body>
        <!-- Loading State Inicial -->
        <div class="page-loader" id="page-loader">
            <div style="text-align: center;">
                <i
                    data-lucide="loader-2"
                    class="spin"
                    style="width: 50px; height: 50px; color: var(--primary); margin-bottom: 1rem;"
                ></i>
                <p style="color: var(--text-secondary); font-size: 0.9rem; letter-spacing: 0.05em;">
                    Cargando Panel de Control...
                </p>
            </div>
        </div>

        <div class="dashboard-container" id="dashboard-container" style="display: none;">
            <div class="sidebar-overlay" id="sidebar-overlay"></div>
            
            <Sidebar />

            <!-- Main Content -->
            <main class="main-content">
                <Header />
                <slot />
            </main>
        </div>
    </body>
</html>
