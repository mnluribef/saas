---
// src/layouts/AdminLayout.astro
import Sidebar from '../components/admin/Sidebar.astro';
import Header from '../components/admin/Header.astro';
import '../styles/admin.css';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Ventrina | Panel Administrativo</title>
        <meta name="robots" content="noindex, nofollow" />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
        <link rel="apple-touch-icon" href="/assets/favicon.svg" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />

        <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest" is:inline></script>
        
        <!-- Chart.js -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
        
        <!-- Admin Settings Stylesheet -->
        <link rel="stylesheet" href="/admin-settings.css" />
    </head>
    <body>
        <!-- Loading State Inicial -->
        <div class="page-loader" id="page-loader">
            <div class="loader-content">
                <i
                    data-lucide="loader-2"
                    class="spin loader-spinner"
                ></i>
                <p class="loader-text">
                    Cargando Panel de Control...
                </p>
            </div>
        </div>

        <div class="dashboard-container d-none" id="dashboard-container">
            <div class="sidebar-overlay" id="sidebar-overlay"></div>
            
            <Sidebar />

            <!-- Main Content -->
            <main class="main-content">
                <Header />
                <slot />
            </main>
        </div>
    </body>
</html>
