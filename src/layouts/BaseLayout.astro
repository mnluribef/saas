---
// BaseLayout.astro - Layout principal configurable
import type { StoreConfig } from '../types/store.types';
import defaultStoreConfig from '../config/store.config';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  config?: StoreConfig;
}

const {
  config = defaultStoreConfig,
  title = config.seo.title,
  description = config.seo.description,
  ogImage = config.business.ogImage,
} = Astro.props;

const siteUrl = config.business.siteUrl || 'https://vendly.pages.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();

// Generar Schema.org dinámico según el tipo de tienda
const schemaOrgData = {
  "@context": "https://schema.org",
  "@type": config.seo.schemaType || "Store",
  "name": config.business.name,
  "description": config.business.description,
  "url": siteUrl,
  "telephone": config.contact.phone || `+${config.contact.whatsapp}`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": config.contact.address,
    "addressLocality": config.contact.addressLocality || "La Victoria",
    "addressRegion": config.contact.addressRegion || "Aragua",
    "addressCountry": config.contact.addressCountry || "VE"
  },
  "openingHours": config.contact.hours,
  "priceRange": config.seo.priceRange || "$$",
  ...(config.seo.servesCuisine ? { "servesCuisine": config.seo.servesCuisine } : {}),
  ...(config.template === 'restaurant' ? { "hasMenu": `${siteUrl}#menu` } : {})
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={config.seo.keywords}>
  <meta name="author" content={config.business.name}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={config.template === 'restaurant' ? 'restaurant' : 'website'}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={fullOgImage}>
  <meta property="og:image:secure_url" content={fullOgImage}>
  <meta property="og:image:width" content="1376">
  <meta property="og:image:height" content="768">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalUrl}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={fullOgImage}>

  <!-- Structured Data Dinámico -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />

  <!-- Google Fonts Dinámico por Plantilla -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={config.theme.googleFontsUrl} rel="stylesheet">

  <!-- Global CSS Base -->
  <link rel="stylesheet" href="/style.css?v=8">

  <!-- Variables de Tema Dinámicas del Template Activo -->
  <style is:inline define:vars={{
    themePrimary: config.theme.primaryColor,
    themePrimaryHover: config.theme.primaryHover,
    themePrimaryDeep: config.theme.primaryDeep || config.theme.primaryHover,
    themePrimaryLight: config.theme.primaryLight,
    themePrimaryPale: config.theme.primaryPale || config.theme.primaryLight,

    themeAccent: config.theme.accentColor,
    themeAccentHover: config.theme.accentHover || config.theme.accentColor,
    themeAccentLight: config.theme.accentLight || 'rgba(0,0,0,0.1)',
    themeAccentPale: config.theme.accentPale || '#FFFFFF',

    themeBgPage: config.theme.bgPage || '#FFFDF9',
    themeBgSection: config.theme.bgSection || '#FFF5EE',
    themeBgCard: config.theme.bgCard || '#FFFFFF',

    themeBorderSubtle: config.theme.borderSubtle || 'rgba(0, 0, 0, 0.08)',
    themeBorderFocus: config.theme.borderFocus || config.theme.primaryColor,

    themeTextHeading: config.theme.textHeading || '#1C0A00',
    themeTextBody: config.theme.textBody || '#3D2214',
    themeTextMuted: config.theme.textMuted || '#7A523B',
    themeTextLight: config.theme.textLight || '#A67C65',

    themeHeroBg: config.theme.heroBg || '#1A0B02',
    themeHeroOverlay: config.theme.heroOverlay || 'linear-gradient(to bottom right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%)',
    themeHeroFade: config.theme.heroFadeBottom || `linear-gradient(to top, ${config.theme.bgPage || '#FFFDF9'} 0%, transparent 100%)`,

    themeGradHero: config.theme.gradHero || `linear-gradient(135deg, ${config.theme.primaryHover} 0%, ${config.theme.primaryColor} 55%, ${config.theme.accentColor} 100%)`,
    themeGradCta: config.theme.gradCta || `linear-gradient(135deg, ${config.theme.primaryHover} 0%, ${config.theme.primaryColor} 100%)`,
    themeGradSection: config.theme.gradSection || `linear-gradient(160deg, ${config.theme.bgPage || '#FFFDF9'} 0%, ${config.theme.bgSection || '#FFF5EE'} 100%)`,
    themeGradAccent: config.theme.gradAccent || `linear-gradient(135deg, ${config.theme.accentHover || config.theme.accentColor} 0%, ${config.theme.accentColor} 100%)`,

    themeShadow: `0 12px 36px ${config.theme.shadowColor || 'rgba(0,0,0,0.18)'}`,
    themeShadowCard: config.theme.shadowCard || '0 4px 20px rgba(0, 0, 0, 0.06)',

    themeBadgeBg: config.theme.badgeBg || 'rgba(212, 175, 55, 0.14)',
    themeBadgeBorder: config.theme.badgeBorder || 'rgba(212, 175, 55, 0.38)',
    themeBadgeText: config.theme.badgeText || config.theme.accentColor,

    fontHeading: config.theme.fontHeading,
    fontBody: config.theme.fontBody
  }}>
    :root {
      --rose: var(--themePrimary) !important;
      --rose-deep: var(--themePrimaryHover) !important;
      --rose-dark: var(--themePrimaryDeep) !important;
      --rose-light: var(--themePrimaryLight) !important;
      --rose-pale: var(--themePrimaryPale) !important;

      --gold: var(--themeAccent) !important;
      --gold-deep: var(--themeAccentHover) !important;
      --gold-light: var(--themeAccentLight) !important;
      --gold-pale: var(--themeAccentPale) !important;

      --cream: var(--themeBgPage) !important;
      --blush: var(--themeBgSection) !important;
      --bg-card: var(--themeBgCard) !important;

      --border-subtle: var(--themeBorderSubtle) !important;
      --border-focus: var(--themeBorderFocus) !important;

      --text-heading: var(--themeTextHeading) !important;
      --text-body: var(--themeTextBody) !important;
      --text-muted: var(--themeTextMuted) !important;
      --text-light: var(--themeTextLight) !important;

      --hero-bg: var(--themeHeroBg) !important;
      --hero-overlay: var(--themeHeroOverlay) !important;
      --hero-fade-bottom: var(--themeHeroFade) !important;

      --grad-hero: var(--themeGradHero) !important;
      --grad-cta: var(--themeGradCta) !important;
      --grad-section: var(--themeGradSection) !important;
      --grad-gold: var(--themeGradAccent) !important;

      --shadow-rose: var(--themeShadow) !important;
      --shadow-card: var(--themeShadowCard) !important;

      --badge-bg: var(--themeBadgeBg) !important;
      --badge-border: var(--themeBadgeBorder) !important;
      --badge-text: var(--themeBadgeText) !important;

      --font-heading: var(--fontHeading) !important;
      --font-body: var(--fontBody) !important;
    }

    body {
      background-color: var(--cream) !important;
      color: var(--text-body) !important;
      font-family: var(--font-body) !important;
    }

    h1, h2, h3, h4, .hero-content h1, .section-header h2, .logo, .product-header h3, .process-number {
      font-family: var(--font-heading) !important;
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
